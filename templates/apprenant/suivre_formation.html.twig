    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 14px;
    color: #64748b;
    flex-shrink: 0;
}

.tera-lecon-item.active .tera-lecon-number {
    background: rgba(255, 255, 255, 0.2);
    color: white;
}

.tera-lecon-content {
    flex: 1;
}

.tera-lecon-title {
    font-weight: 700;
    font-size: 14px;
    color: #0f172a;
    line-height: 1.4;
    margin-bottom: 4px;
}

.tera-lecon-item.active .tera-lecon-title {
    color: white;
}

.tera-lecon-duration {
    font-size: 12px;
    color: #94a3b8;
    font-weight: 600;
}

.tera-lecon-item.active .tera-lecon-duration {
    color: rgba(255, 255, 255, 0.8);
}

.tera-lecon-status {
    font-size: 20px;
    color: #cbd5e1;
}

.tera-lecon-item.active .tera-lecon-status {
    color: white;
}

.tera-lecon-completed .tera-lecon-status {
