  <script>
    document.addEventListener('DOMContentLoaded', function() {
        const liveModal = document.getElementById('live-modal');
        const video = document.getElementById('live-video');
        const closeLive = document.querySelector('.close-live');
        const reactionsFeed = document.getElementById('reactions-feed');
        let hls = null;
        let currentLiveId = null;
        let reactionInterval = null;
        let lastReactionId = 0;
        let lastCommentId = 0;

        // --- Functions ---
        async function fetchActivities() {
            if (!currentLiveId) return;
            try {
                // Fetch Reactions
                const resReact = await fetch(`/api/reactions/event/${currentLiveId}`);
                const reactions = await resReact.json();
                reactions.reverse().forEach(r => {
                    if (r.id > lastReactionId) {
                        addReactionToFeed(r.userName, r.type);
                        lastReactionId = r.id;
                    }
                });

                // Fetch Comments
                const resComm = await fetch(`/api/comments/event/${currentLiveId}`);
                const comments = await resComm.json();
                comments.reverse().forEach(c => {
                    if (c.id > lastCommentId) {
                        addCommentToFeed(c.userName, c.content);
                        lastCommentId = c.id;
                    }
                });
            } catch (error) {
                console.error("Error fetching activities:", error);
            }
        }

        function addReactionToFeed(userName, type) {
            if (!reactionsFeed) return;
            const item = document.createElement('div');
            item.className = 'reaction-item';
            item.innerHTML = `<strong>${userName}</strong> ${type}`;
            reactionsFeed.prepend(item);
            if (reactionsFeed.children.length > 20) reactionsFeed.lastChild.remove();
        }

        function addCommentToFeed(userName, content) {
            if (!reactionsFeed) return;
            const item = document.createElement('div');
            item.className = 'reaction-item comment-item';
            item.style.borderLeft = '3px solid #6974e8'; // Blue for comments
            item.innerHTML = `<strong>${userName}:</strong> ${content}`;
            reactionsFeed.prepend(item);
            if (reactionsFeed.children.length > 20) reactionsFeed.lastChild.remove();
        }

        async function sendReaction(type) {
            if (!currentLiveId) return;
            try {
                const response = await fetch('/api/reactions', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ eventId: currentLiveId, type: type })
                });
                const data = await response.json();
                if (data.success) {
                    addReactionToFeed(data.userName, data.type);
                }
            } catch (error) {
                console.error("Error sending reaction:", error);
            }
        }

        async function sendComment() {
            const input = document.getElementById('live-comment-input');
            const content = input.value.trim();
            if (!currentLiveId || !content) return;

            try {
                const response = await fetch('/api/comments', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ eventId: currentLiveId, content: content })
                });
                const data = await response.json();
                if (data.success) {
                    addCommentToFeed(data.userName, data.content);
                    input.value = '';
                }
            } catch (error) {
                console.error("Error sending comment:", error);
            }
        }

        const stopLive = () => {
            liveModal.style.display = 'none';
            document.body.style.overflow = 'auto';
            currentLiveId = null;
            if (reactionInterval) clearInterval(reactionInterval);
            
            const youtube = document.getElementById('live-youtube');
            youtube.src = "";
            youtube.style.display = 'none';
            if (hls) { hls.destroy(); hls = null; }
            video.pause();
            video.src = "";
            video.style.display = 'none';
        };

        async function updateStats() {
            document.querySelectorAll('.reaction-count-badge').forEach(async (badge) => {
                const id = badge.getAttribute('data-event-id');
                try {
                    const res = await fetch(`/api/reactions/stats/${id}`);
                    const data = await res.json();
                    badge.querySelector('.count-val').textContent = data.total;
                } catch (e) {}
            });
        }

        async function checkLiveUpdate() {
            try {
                const res = await fetch('/api/evenements/live-stream');
                const liveDataList = await res.json();

                document.querySelectorAll('.event-card').forEach(card => {
                    const eventId = parseInt(card.getAttribute('data-event-id'));
                    if (isNaN(eventId)) return;
                    const btnLive = card.querySelector('.btn-live');
                    if (!btnLive) return;

                    const liveData = liveDataList.find(d => parseInt(d.id) === eventId);
                    if (liveData) {
                        if (!btnLive.classList.contains('active')) {
                            btnLive.classList.remove('disabled');
                            btnLive.classList.add('active', 'btn-live-trigger');
                            btnLive.removeAttribute('disabled');
                            btnLive.setAttribute('data-stream', liveData.streamUrl);
                            btnLive.innerHTML = '<span class="live-dot"></span> <strong>EN DIRECT</strong>';
                        }
                    } else {
                        if (btnLive.classList.contains('active')) {
                            btnLive.classList.remove('active', 'btn-live-trigger');
                            btnLive.classList.add('disabled');
                            btnLive.setAttribute('disabled', 'disabled');
                            btnLive.innerHTML = '<i class="fa fa-ban"></i> Live non dispo';
                        }
                    }
                });
                updateStats();
            } catch (error) { console.error("Polling error:", error); }
        }

        // --- Event Listeners ---
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.btn-live-trigger');
            if (btn) {
                const streamUrl = btn.getAttribute('data-stream');
                const card = btn.closest('.event-card');
                currentLiveId = card ? card.getAttribute('data-event-id') : null;
                if (!streamUrl) return;

                liveModal.style.display = 'block';
                document.body.style.overflow = 'hidden';
                if (reactionsFeed) reactionsFeed.innerHTML = '';
                lastReactionId = 0;
                lastCommentId = 0;

                // Activities Polling
                if (reactionInterval) clearInterval(reactionInterval);
                fetchActivities();
                reactionInterval = setInterval(fetchActivities, 2000);

                const youtubeRegex = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?|live)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i;
                const match = streamUrl.match(youtubeRegex);

                if (match) {
                    const videoId = match[1];
                    const youtube = document.getElementById('live-youtube');
                    youtube.src = `https://www.youtube.com/embed/${videoId}?autoplay=1`;
                    youtube.style.display = 'block';
                    video.style.display = 'none';
                } else {
                    video.style.display = 'block';
                    document.getElementById('live-youtube').style.display = 'none';
                    if (Hls.isSupported()) {
                        hls = new Hls();
                        hls.loadSource(streamUrl);
                        hls.attachMedia(video);
                        hls.on(Hls.Events.MANIFEST_PARSED, () => video.play());
                    } else if (video.canPlayType('application/vnd.apple.mpegurl')) {
                        video.src = streamUrl;
                        video.play();
                    }
                }
            }
        });

        document.querySelectorAll('.btn-react').forEach(btn => {
            btn.addEventListener('click', () => sendReaction(btn.getAttribute('data-type')));
        });

        // Comment event listeners
        document.getElementById('btn-send-comment')?.addEventListener('click', sendComment);
        document.getElementById('live-comment-input')?.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') sendComment();
        });

        if (closeLive) closeLive.addEventListener('click', stopLive);
        window.addEventListener('click', (e) => { if (e.target === liveModal) stopLive(); });

        setInterval(checkLiveUpdate, 5000);
        checkLiveUpdate();
    });
  </script>
