    <script>
    async function fetchRecommendedEvents() {
        const filiere = document.getElementById('filiereSelect').value;
        const container = document.getElementById('recommendationsContainer');
        
        if (!filiere) {
            container.innerHTML = `
                <div class="w-100 text-center py-4 text-muted">
                    <i class="fa fa-search display-6 mb-2 d-block opacity-50" style="font-size: 2rem;"></i>
                    <br>
                    Sélectionnez une filière ci-dessus pour découvrir nos suggestions
                </div>`;
            return;
        }

        container.innerHTML = '<div class="w-100 text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>';
        
        try {
            const response = await fetch(`/api/evenements?filiere=${filiere}`);
            const events = await response.json();
            
            if (events.length === 0) {
                container.innerHTML = `
                    <div class="w-100 text-center py-4 text-muted">
                        <i class="fa fa-frown-o display-6 mb-2 d-block opacity-50" style="font-size: 2rem;"></i>
                        <br>
                        Aucun événement trouvé pour cette filière pour le moment.
                    </div>`;
                return;
            }

            container.innerHTML = events.map(event => `
                <div class="card shadow-sm border-0 flex-shrink-0" style="width: 300px; margin-right: 15px; border-radius: 15px; overflow: hidden;">
                   <div style="height: 10px; background-color: #6974e8;"></div>
                    <div class="card-body p-3">
                        <span class="badge bg-primary mb-2" style="background-color: #6974e8 !important;">${event.filieres && event.filieres.length > 0 ? event.filieres[0] : 'Événement'}</span>
                        <h6 class="card-title text-truncate mb-1" title="${event.titre || ''}" style="font-weight: 700;">${event.titre || 'Sans titre'}</h6>
                        <p class="card-text small text-muted text-truncate mb-2">${event.lieu || 'En ligne'}</p>
                        
                        <div class="d-flex justify-content-between align-items-center mt-3">
                            <small class="text-primary fw-bold" style="color: #6974e8 !important;">
                                <i class="fa fa-calendar me-1"></i>${event.date ? new Date(event.date).toLocaleDateString() : 'Date inconnue'}
                            </small>
                        </div>
                    </div>
                </div>
            `).join('');
            
        } catch (error) {
            console.error(error);
            container.innerHTML = '<div class="w-100 text-center text-danger py-4">Erreur lors du chargement des recommandations.</div>';
        }
    }
  </script>

