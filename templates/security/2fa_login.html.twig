{% extends 'base.html.twig' %}

{% block title %}Two-Factor Authentication{% endblock %}

{% block stylesheets %}
<style>
.auth-container {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
}

.auth-card {
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-radius: 20px;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    max-width: 450px;
    width: 100%;
    overflow: hidden;
    animation: slideUp 0.5s ease-out;
}

@keyframes slideUp {
    from {
        opacity: 0;
        transform: translateY(30px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.auth-header {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: white;
    padding: 30px;
    text-align: center;
}

.auth-header h4 {
    margin: 0;
    font-weight: 600;
    font-size: 1.5rem;
}

.auth-header .subtitle {
    margin-top: 10px;
    opacity: 0.9;
    font-size: 0.9rem;
}

.auth-body {
    padding: 40px 30px;
}

.code-input-group {
    position: relative;
    margin-bottom: 30px;
}

.code-input {
    width: 100%;
    height: 60px;
    font-size: 2rem;
    font-weight: bold;
    text-align: center;
    letter-spacing: 0.5rem;
    border: 2px solid #e0e0e0;
    border-radius: 12px;
    transition: all 0.3s ease;
    background: #f8f9fa;
}

.code-input:focus {
    border-color: #667eea;
    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
    background: white;
    transform: scale(1.02);
}

.code-input.error {
    border-color: #dc3545;
    animation: shake 0.5s ease-in-out;
}

@keyframes shake {
    0%, 100% { transform: translateX(0); }
    25% { transform: translateX(-10px); }
    75% { transform: translateX(10px); }
}

.trust-device {
    background: #f8f9fa;
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 25px;
    border: 1px solid #e9ecef;
}

.trust-device .form-check-input:checked {
    background-color: #667eea;
    border-color: #667eea;
}

.btn-verify {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    border: none;
    border-radius: 12px;
    padding: 15px 30px;
    font-weight: 600;
    font-size: 1.1rem;
    transition: all 0.3s ease;
    position: relative;
    overflow: hidden;
}

.btn-verify:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px rgba(102, 126, 234, 0.3);
}

.btn-verify:active {
    transform: translateY(0);
}

.help-text {
    text-align: center;
    margin-top: 25px;
    color: #6c757d;
    font-size: 0.9rem;
}

.help-text a {
    color: #667eea;
    text-decoration: none;
    font-weight: 500;
}

.help-text a:hover {
    text-decoration: underline;
}

.alert-danger {
    border-radius: 12px;
    border: none;
    background: #fee;
    color: #dc3545;
    padding: 15px 20px;
    margin-bottom: 25px;
    animation: slideDown 0.3s ease-out;
}

@keyframes slideDown {
    from {
        opacity: 0;
        transform: translateY(-10px);
    }
    to {
        opacity: 1;
        transform: translateY(0);
    }
}

.security-badge {
    display: inline-flex;
    align-items: center;
    background: rgba(102, 126, 234, 0.1);
    color: #667eea;
    padding: 8px 16px;
    border-radius: 20px;
    font-size: 0.8rem;
    font-weight: 500;
    margin-bottom: 20px;
}

.security-badge i {
    margin-right: 8px;
}
</style>
{% endblock %}

{% block body %}
<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h4>
                <i class="bi bi-shield-check"></i>
                Two-Factor Authentication
            </h4>
            <div class="subtitle">Enter your verification code to continue</div>
        </div>
        
        <div class="auth-body">
            <div class="security-badge">
                <i class="bi bi-lock-fill"></i>
                Secure Login Required
            </div>

            {% if authenticationError %}
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    {{ authenticationError|trans }}
                </div>
            {% endif %}

            <form action="{{ checkPathUrl }}" method="post" id="2fa-form" data-turbo="false">
                {% if displayTrustedOption %}
                    <div class="trust-device">
                        <div class="form-check">
                            <input type="checkbox" id="trusted" name="trusted" class="form-check-input">
                            <label for="trusted" class="form-check-label">
                                <strong>Trust this device</strong><br>
                                <small class="text-muted">Don't ask for codes on this device for 30 days</small>
                            </label>
                        </div>
                    </div>
                {% endif %}

                <div class="code-input-group">
                    <label for="auth_code" class="form-label fw-bold">Authentication Code</label>
                    <input 
                        type="text" 
                        id="auth_code" 
                        name="auth_code" 
                        class="form-control code-input" 
                        placeholder="000000"
                        pattern="[0-9]{6}"
                        maxlength="6"
                        autocomplete="one-time-code"
                        inputmode="numeric"
                        required
                        autofocus
                    >
                    <div class="form-text text-center mt-2">
                        Enter the 6-digit code from your authenticator app
                    </div>
                </div>

                {% if csrfTokenInput %}
                    {{ csrfTokenInput }}
                {% endif %}

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-verify">
                        <i class="bi bi-shield-check me-2"></i>
                        Verify & Continue
                    </button>
                </div>

                <div class="help-text">
                    Having trouble? 
                    <a href="{{ path('app_logout') }}" class="text-decoration-none fw-bold">Cancel and logout</a>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const authCodeInput = document.getElementById('auth_code');
    const form = document.getElementById('2fa-form');
    
    // Focus on the input field
    authCodeInput.focus();
    
    // Auto-format and validation
    authCodeInput.addEventListener('input', function(e) {
        // Remove any non-numeric characters
        this.value = this.value.replace(/[^0-9]/g, '');
        
        // Remove error class if present
        this.classList.remove('error');
        
        // Auto-submit when 6 digits are entered
        if (this.value.length === 6) {
            // Add a small delay for better UX
            setTimeout(() => {
                if (this.value.length === 6) {
                    form.submit();
                }
            }, 300);
        }
    });
    
    // Handle paste events
    authCodeInput.addEventListener('paste', function(e) {
        e.preventDefault();
        const pastedData = (e.clipboardData || window.clipboardData).getData('text');
        const numericData = pastedData.replace(/[^0-9]/g, '').slice(0, 6);
        this.value = numericData;
        
        // Remove error class if present
        this.classList.remove('error');
        
        if (this.value.length === 6) {
            setTimeout(() => {
                form.submit();
            }, 300);
        }
    });
    
    // Add error animation on failed submission
    {% if authenticationError %}
        authCodeInput.classList.add('error');
        // Focus back to input on error
        authCodeInput.focus();
        authCodeInput.select();
    {% endif %}
    
    // Prevent form submission on Enter if code is incomplete
    form.addEventListener('submit', function(e) {
        if (authCodeInput.value.length !== 6) {
            e.preventDefault();
            authCodeInput.classList.add('error');
            authCodeInput.focus();
        }
    });
});
</script>
{% endblock %}
