{% extends 'base.html.twig' %}

{% block title %}Vérification par Téléphone{% endblock %}

{% block stylesheets %}
<style>
    .phone-verification-container {
        max-width: 500px;
        margin: 50px auto;
        padding: 30px;
        background: white;
        border-radius: 10px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.1);
    }

    .verification-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .verification-header h2 {
        color: #333;
        margin-bottom: 10px;
    }

    .verification-header p {
        color: #666;
        font-size: 14px;
    }

    .form-group {
        margin-bottom: 20px;
    }

    .form-group label {
        display: block;
        margin-bottom: 8px;
        font-weight: 600;
        color: #333;
    }

    .form-control {
        width: 100%;
        padding: 12px;
        border: 2px solid #ddd;
        border-radius: 5px;
        font-size: 16px;
        transition: border-color 0.3s;
    }

    .form-control:focus {
        outline: none;
        border-color: #007bff;
        box-shadow: 0 0 0 3px rgba(0,123,255,0.1);
    }

    .btn {
        width: 100%;
        padding: 12px;
        border: none;
        border-radius: 5px;
        font-size: 16px;
        font-weight: 600;
        cursor: pointer;
        transition: background-color 0.3s;
    }

    .btn-primary {
        background-color: #007bff;
        color: white;
    }

    .btn-primary:hover {
        background-color: #0056b3;
    }

    .btn-secondary {
        background-color: #6c757d;
        color: white;
        margin-top: 10px;
    }

    .btn-secondary:hover {
        background-color: #545b62;
    }

    .alert {
        padding: 12px;
        border-radius: 5px;
        margin-bottom: 20px;
        font-size: 14px;
    }

    .alert-success {
        background-color: #d4edda;
        border: 1px solid #c3e6cb;
        color: #155724;
    }

    .alert-danger {
        background-color: #f8d7da;
        border: 1px solid #f5c6cb;
        color: #721c24;
    }

    .alert-info {
        background-color: #d1ecf1;
        border: 1px solid #bee5eb;
        color: #0c5460;
    }

    .phone-input-group {
        position: relative;
    }

    .phone-prefix {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #666;
        font-weight: 600;
    }

    .phone-input {
        padding-left: 50px;
    }

    .code-input {
        letter-spacing: 3px;
        text-align: center;
        font-size: 20px;
        font-weight: bold;
    }

    .resend-code {
        text-align: center;
        margin-top: 20px;
    }

    .resend-code a {
        color: #007bff;
        text-decoration: none;
        font-size: 14px;
    }

    .resend-code a:hover {
        text-decoration: underline;
    }

    .verification-steps {
        background-color: #f8f9fa;
        padding: 20px;
        border-radius: 5px;
        margin-bottom: 20px;
    }

    .verification-steps h4 {
        color: #333;
        margin-bottom: 15px;
        font-size: 16px;
    }

    .verification-steps ol {
        margin: 0;
        padding-left: 20px;
    }

    .verification-steps li {
        margin-bottom: 8px;
        color: #666;
        font-size: 14px;
    }

    .loading {
        display: none;
        text-align: center;
        margin: 10px 0;
    }

    .spinner {
        border: 2px solid #f3f3f3;
        border-top: 2px solid #007bff;
        border-radius: 50%;
        width: 20px;
        height: 20px;
        animation: spin 1s linear infinite;
        display: inline-block;
        margin-right: 10px;
    }

    @keyframes spin {
        0% { transform: rotate(0deg); }
        100% { transform: rotate(360deg); }
    }
</style>
{% endblock %}

{% block body %}
<div class="phone-verification-container">
    <div class="verification-header">
        <h2>{% block verification_title %}Vérification par Téléphone{% endblock %}</h2>
        <p>{% block verification_subtitle %}Sécurisez votre compte avec votre numéro de téléphone{% endblock %}</p>
    </div>

    {% block verification_content %}
    <div class="verification-steps">
        <h4>Comment ça marche ?</h4>
        <ol>
            <li>Entrez votre numéro de téléphone tunisien</li>
            <li>Recevez un code de vérification par SMS</li>
            <li>Entrez le code pour confirmer votre numéro</li>
            <li>Votre compte sera sécurisé avec la vérification par téléphone</li>
        </ol>
    </div>

    <div id="alert-container"></div>

    <!-- Step 1: Phone Number Entry -->
    <div id="phone-step">
        <form id="phone-form" data-turbo="false">
            <div class="form-group">
                <label for="phone">Numéro de Téléphone</label>
                <div class="phone-input-group">
                    <span class="phone-prefix">+216</span>
                    <input type="tel" 
                           id="phone" 
                           name="phone" 
                           class="form-control phone-input" 
                           placeholder="XX XXX XXX"
                           pattern="[0-9]{8}"
                           maxlength="8"
                           required>
                </div>
                <small style="color: #666; font-size: 12px;">
                    Format: XX XXX XXX (8 chiffres sans l'indicatif pays)
                </small>
            </div>

            <button type="submit" class="btn btn-primary" id="send-code-btn">
                Envoyer le code de vérification
            </button>

            <div class="loading" id="phone-loading">
                <div class="spinner"></div>
                Envoi en cours...
            </div>
        </form>
    </div>

    <!-- Step 2: Code Verification -->
    <div id="code-step" style="display: none;">
        <form id="code-form" data-turbo="false">
            <div class="form-group">
                <label for="code">Code de Vérification</label>
                <input type="text" 
                       id="code" 
                       name="code" 
                       class="form-control code-input" 
                       placeholder="000000"
                       pattern="[0-9]{6}"
                       maxlength="6"
                       required>
                <small style="color: #666; font-size: 12px;">
                    Entrez le code à 6 chiffres reçu par SMS
                </small>
            </div>

            <button type="submit" class="btn btn-primary" id="verify-code-btn">
                Vérifier le code
            </button>

            <div class="loading" id="code-loading">
                <div class="spinner"></div>
                Vérification en cours...
            </div>

            <div class="resend-code">
                <a href="#" id="resend-code">Renvoyer le code</a>
            </div>
        </form>
    </div>
    {% endblock %}

    <div class="text-center" style="margin-top: 20px;">
        <a href="{{ path('accueil') }}" class="btn btn-secondary">
            Retour à l'accueil
        </a>
    </div>
</div>
{% endblock %}

{% block javascripts %}
<script>
document.addEventListener('DOMContentLoaded', function() {
    const phoneForm = document.getElementById('phone-form');
    const codeForm = document.getElementById('code-form');
    const phoneStep = document.getElementById('phone-step');
    const codeStep = document.getElementById('code-step');
    const phoneInput = document.getElementById('phone');
    const codeInput = document.getElementById('code');
    const sendCodeBtn = document.getElementById('send-code-btn');
    const verifyCodeBtn = document.getElementById('verify-code-btn');
    const resendCodeLink = document.getElementById('resend-code');
    const phoneLoading = document.getElementById('phone-loading');
    const codeLoading = document.getElementById('code-loading');
    const alertContainer = document.getElementById('alert-container');

    function showAlert(message, type) {
        alertContainer.innerHTML = `<div class="alert alert-${type}">${message}</div>`;
        setTimeout(() => {
            alertContainer.innerHTML = '';
        }, 5000);
    }

    function formatPhoneNumber(value) {
        // Remove all non-numeric characters
        return value.replace(/\D/g, '');
    }

    phoneInput.addEventListener('input', function() {
        this.value = formatPhoneNumber(this.value);
    });

    codeInput.addEventListener('input', function() {
        this.value = formatPhoneNumber(this.value);
    });

    phoneForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const phone = phoneInput.value.trim();
        
        if (phone.length !== 8) {
            showAlert('Veuillez entrer un numéro de téléphone valide (8 chiffres)', 'danger');
            return;
        }

        sendCodeBtn.disabled = true;
        phoneLoading.style.display = 'block';

        try {
            const response = await fetch('/api/phone-verification/send', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ phone: phone })
            });

            const result = await response.json();

            if (result.success) {
                showAlert('Code de vérification envoyé avec succès!', 'success');
                phoneStep.style.display = 'none';
                codeStep.style.display = 'block';
                codeInput.focus();
            } else {
                showAlert(result.message || 'Erreur lors de l\'envoi du code', 'danger');
            }
        } catch (error) {
            showAlert('Erreur de connexion. Veuillez réessayer.', 'danger');
        } finally {
            sendCodeBtn.disabled = false;
            phoneLoading.style.display = 'none';
        }
    });

    codeForm.addEventListener('submit', async function(e) {
        e.preventDefault();
        
        const code = codeInput.value.trim();
        
        if (code.length !== 6) {
            showAlert('Veuillez entrer un code à 6 chiffres', 'danger');
            return;
        }

        verifyCodeBtn.disabled = true;
        codeLoading.style.display = 'block';

        try {
            const response = await fetch('/api/phone-verification/verify', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ code: code })
            });

            const result = await response.json();

            if (result.success) {
                showAlert('Téléphone vérifié avec succès!', 'success');
                setTimeout(() => {
                    window.location.href = '{{ path("accueil") }}';
                }, 2000);
            } else {
                showAlert(result.message || 'Code invalide', 'danger');
            }
        } catch (error) {
            showAlert('Erreur de connexion. Veuillez réessayer.', 'danger');
        } finally {
            verifyCodeBtn.disabled = false;
            codeLoading.style.display = 'none';
        }
    });

    resendCodeLink.addEventListener('click', async function(e) {
        e.preventDefault();
        
        const phone = phoneInput.value.trim();
        
        resendCodeLink.style.opacity = '0.5';
        resendCodeLink.style.pointerEvents = 'none';

        try {
            const response = await fetch('/api/phone-verification/send', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'X-Requested-With': 'XMLHttpRequest'
                },
                body: JSON.stringify({ phone: phone })
            });

            const result = await response.json();

            if (result.success) {
                showAlert('Code renvoyé avec succès!', 'success');
            } else {
                showAlert(result.message || 'Erreur lors du renvoi', 'danger');
            }
        } catch (error) {
            showAlert('Erreur de connexion. Veuillez réessayer.', 'danger');
        } finally {
            resendCodeLink.style.opacity = '1';
            resendCodeLink.style.pointerEvents = 'auto';
        }
    });
});
</script>
{% endblock %}
