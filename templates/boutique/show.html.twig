{% extends 'base.html.twig' %}

{% block title %}{{ produit.nom }} - Détails{% endblock %}

{% block body %}
    <div class="container-fluid">
        <!-- BREADCRUMB -->
        <div class="tera-breadcrumb mb-4">
            <div class="container">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb mb-0">
                        <li class="breadcrumb-item">
                            <a href="{{ path('accueil') }}">
                                <i class="bi bi-house-door me-1"></i>Accueil
                            </a>
                        </li>
                        <li class="breadcrumb-item">
                            <a href="{{ path('boutique_index') }}">
                                <i class="bi bi-shop me-1"></i>Boutique
                            </a>
                        </li>
                        <li class="breadcrumb-item active">{{ produit.nom }}</li>
                    </ol>
                </nav>
            </div>
        </div>

        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show mx-auto" style="max-width: 1200px;" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}

        <div class="container">
            <div class="row">
                <!-- LEFT: IMAGE -->
                <div class="col-lg-6">
                    <div class="tera-product-image-wrapper">
                        {% if produit.image %}
                            <img src="{{ asset('uploads/produits/' ~ produit.image) }}" 
                                 alt="{{ produit.nom }}" 
                                 class="tera-product-main-image">
                        {% else %}
                            <div class="tera-product-placeholder">
                                <i class="bi bi-image"></i>
                                <p class="mt-3 mb-0 text-muted">Aucune image</p>
                            </div>
                        {% endif %}
                    </div>
                </div>

                <!-- RIGHT: DETAILS -->
                <div class="col-lg-6">
                    <div class="tera-product-details">
                        <!-- Category Badge -->
                        <div class="mb-3">
                            <span class="tera-category-pill">
                                <i class="bi bi-tag me-2"></i>{{ produit.categorie }}
                            </span>
                        </div>

                        <!-- Product Title -->
                        <h1 class="tera-product-name mb-4">{{ produit.nom }}</h1>
                        
                        <!-- Price Section -->
                        <div class="tera-price-section mb-4">
                            <div class="tera-price-amount">
                                <span class="tera-price-value">{{ produit.prix|number_format(2, ',', ' ') }}</span>
                                <span class="tera-price-currency">Dt</span>
                            </div>
                            <div class="tera-price-info">
                                <i class="bi bi-truck me-1"></i>Livraison gratuite
                            </div>
                        </div>

                        <!-- Description -->
                        {% if produit.description %}
                            <div class="tera-description-card mb-4">
                                <h5 class="tera-section-title">Description</h5>
                                <p class="tera-description-text">{{ produit.description|nl2br }}</p>
                            </div>
                        {% endif %}

                        <!-- Stock Status -->
                        <div class="tera-stock-status mb-4">
                            {% if produit.stock > 10 %}
                                <div class="tera-stock-badge tera-stock-available">
                                    <i class="bi bi-check-circle-fill me-2"></i>
                                    <span><strong>En stock</strong> ({{ produit.stock }} disponibles)</span>
                                </div>
                            {% elseif produit.stock > 0 %}
                                <div class="tera-stock-badge tera-stock-limited">
                                    <i class="bi bi-exclamation-circle-fill me-2"></i>
                                    <span><strong>Stock limité</strong> ({{ produit.stock }} restants)</span>
                                </div>
                            {% else %}
                                <div class="tera-stock-badge tera-stock-unavailable">
                                    <i class="bi bi-x-circle-fill me-2"></i>
                                    <span><strong>Rupture de stock</strong></span>
                                </div>
                            {% endif %}
                        </div>

                        <!-- Add to Cart Form -->
                        <div class="tera-cart-form mb-4">
                            <form method="post" action="{{ path('boutique_panier_ajouter', {id: produit.id}) }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('add_to_cart' ~ produit.id) }}">
                                
                                <div class="row g-3 align-items-end">
                                    <div class="col-4">
                                        <label for="quantite" class="tera-form-label">Quantité</label>
                                        <input type="number" 
                                               class="tera-quantity-input" 
                                               id="quantite" 
                                               name="quantite" 
                                               value="1" 
                                               min="1" 
                                               max="{{ produit.stock }}"
                                               {% if produit.stock == 0 %}disabled{% endif %}>
                                    </div>
                                    <div class="col-8">
                                        {% if produit.stock > 0 %}
                                            <button type="submit" class="tera-add-to-cart-btn w-100">
                                                <i class="bi bi-cart-plus me-2"></i>Ajouter au panier
                                            </button>
                                        {% else %}
                                            <button class="tera-disabled-btn w-100" disabled>
                                                <i class="bi bi-x-circle me-2"></i>Produit indisponible
                                            </button>
                                        {% endif %}
                                    </div>
                                </div>
                            </form>
                        </div>

                        <!-- Additional Info -->
                        <div class="tera-info-grid">
                            <div class="tera-info-item">
                                <i class="bi bi-shield-check"></i>
                                <div>
                                    <strong>Garantie</strong>
                                    <span>Satisfait ou remboursé</span>
                                </div>
                            </div>
                            <div class="tera-info-item">
                                <i class="bi bi-truck"></i>
                                <div>
                                    <strong>Livraison</strong>
                                    <span>24-48h</span>
                                </div>
                            </div>
                            <div class="tera-info-item">
                                <i class="bi bi-credit-card"></i>
                                <div>
                                    <strong>Paiement</strong>
                                    <span>Sécurisé</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- SUGGESTIONS -->
        {% if suggestions is defined and suggestions is not empty %}
            <div class="container mt-5">
                <div class="tera-suggestions-section">
                    <div class="tera-suggestions-header">
                        <div class="tera-suggestions-icon">
                            <i class="bi bi-tag"></i>
                        </div>
                        <div>
                            <h3 class="tera-suggestions-title">Produits similaires</h3>
                            <p class="tera-suggestions-subtitle">Autres produits de la catégorie "{{ produit.categorie }}"</p>
                        </div>
                    </div>

                    <div class="row g-4">
                        {% for suggestion in suggestions %}
                            <div class="col-md-6 col-lg-3">
                                <div class="tera-suggestion-card">
                                    <div class="tera-suggestion-image">
                                        <a href="{{ path('boutique_produit_show', {id: suggestion.id}) }}">
                                            {% if suggestion.image %}
                                                <img src="{{ asset('uploads/produits/' ~ suggestion.image) }}" alt="{{ suggestion.nom }}">
                                            {% else %}
                                                <div class="tera-suggestion-placeholder">
                                                    <i class="bi bi-image"></i>
                                                </div>
                                            {% endif %}
                                        </a>
                                        <span class="tera-suggestion-category">{{ suggestion.categorie }}</span>
                                    </div>
                                    
                                    <div class="tera-suggestion-content">
                                        <h6 class="tera-suggestion-title">{{ suggestion.nom }}</h6>
                                        <p class="tera-suggestion-price">{{ suggestion.prix|number_format(2, ',', ' ') }} Dt</p>
                                        
                                        <div class="tera-suggestion-actions">
                                            <a href="{{ path('boutique_produit_show', {id: suggestion.id}) }}" class="btn btn-sm btn-outline-primary w-100 mb-2">
                                                <i class="bi bi-eye me-1"></i>Voir détails
                                            </a>
                                            <form method="post" action="{{ path('boutique_panier_ajouter', {id: suggestion.id}) }}">
                                                <input type="hidden" name="quantite" value="1">
                                                <button type="submit" class="btn btn-sm btn-primary w-100">
                                                    <i class="bi bi-cart-plus me-1"></i>Ajouter
                                                </button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        {% endif %}
    </div>
</div>

<style>
/* BREADCRUMB */
.tera-breadcrumb {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    padding: 20px 0;
    border-radius: 0 0 20px 20px;
    box-shadow: 0 8px 25px rgba(102, 126, 234, .2);
}

.tera-breadcrumb .breadcrumb {
    background: transparent;
    padding: 0;
}

.tera-breadcrumb .breadcrumb-item a {
    color: rgba(255, 255, 255, .9);
    text-decoration: none;
    font-weight: 600;
    transition: all .3s ease;
}

.tera-breadcrumb .breadcrumb-item a:hover {
    color: #fff;
    transform: translateX(2px);
}

.tera-breadcrumb .breadcrumb-item.active {
    color: #fff;
    font-weight: 700;
}

.tera-breadcrumb .breadcrumb-item + .breadcrumb-item::before {
    color: rgba(255, 255, 255, .7);
}

/* PRODUCT IMAGE */
.tera-product-image-wrapper {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 8px 25px rgba(15, 23, 42, .1);
    padding: 20px;
    position: sticky;
    top: 20px;
    overflow: hidden;
    border: 1px solid rgba(102, 126, 234, .1);
}

.tera-product-main-image {
    width: 100%;
    height: auto;
    border-radius: 12px;
    transition: transform 0.5s ease;
    box-shadow: 0 5px 15px rgba(0, 0, 0, .1);
}

.tera-product-main-image:hover {
    transform: scale(1.02);
}

.tera-product-placeholder {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 300px;
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    border-radius: 12px;
    color: #94a3b8;
}

.tera-product-placeholder i {
    font-size: 60px;
    opacity: .3;
}

/* PRODUCT DETAILS */
.tera-product-details {
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 8px 25px rgba(15, 23, 42, .1);
    padding: 25px;
    border: 1px solid rgba(102, 126, 234, .1);
}

.tera-category-pill {
    display: inline-flex;
    align-items: center;
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    padding: 6px 12px;
    border-radius: 50px;
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 12px rgba(102, 126, 234, .25);
}

.tera-product-name {
    font-size: 24px;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.2;
    margin: 0;
    letter-spacing: -0.5px;
}

/* PRICE */
.tera-price-section {
    background: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
    padding: 20px;
    border-radius: 16px;
    border: 2px solid #e2e8f0;
    margin-bottom: 20px;
}

.tera-price-amount {
    display: flex;
    align-items: baseline;
    gap: 6px;
    margin-bottom: 6px;
}

.tera-price-value {
    font-size: 32px;
    font-weight: 900;
    color: #0f172a;
    line-height: 1;
}

.tera-price-currency {
    font-size: 18px;
    font-weight: 700;
    color: #0f172a;
}

.tera-price-info {
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
}

/* DESCRIPTION */
.tera-description-card {
    background: #f8fafc;
    padding: 20px;
    border-radius: 12px;
    border-left: 4px solid #667eea;
    margin-bottom: 20px;
}

.tera-section-title {
    font-size: 16px;
    font-weight: 700;
    color: #0f172a;
    margin: 0 0 12px 0;
}

.tera-description-text {
    color: #475569;
    line-height: 1.6;
    font-size: 14px;
    margin: 0;
}

/* STOCK STATUS */
.tera-stock-badge {
    display: flex;
    align-items: center;
    padding: 12px 20px;
    border-radius: 12px;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 20px;
}

.tera-stock-available {
    background: linear-gradient(135deg, #d1fae5 0%, #a7f3d0 100%);
    color: #065f46;
    border: 2px solid #10b981;
}

.tera-stock-limited {
    background: linear-gradient(135deg, #fed7aa 0%, #fbbf24 100%);
    color: #78350f;
    border: 2px solid #f59e0b;
}

.tera-stock-unavailable {
    background: linear-gradient(135deg, #fecaca 0%, #fca5a5 100%);
    color: #7f1d1d;
    border: 2px solid #ef4444;
}

/* CART FORM */
.tera-form-label {
    font-weight: 800;
    color: #0f172a;
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    margin-bottom: 8px;
    display: block;
}

.tera-quantity-input {
    width: 100%;
    padding: 12px;
    border: 2px solid #e2e8f0;
    border-radius: 12px;
    font-size: 16px;
    font-weight: 800;
    text-align: center;
    color: #0f172a;
    background: #fff;
    transition: all .3s ease;
}

.tera-quantity-input:focus {
    outline: none;
    border-color: #667eea;
    box-shadow: 0 0 0 3px rgba(102, 126, 234, .1);
}

.tera-add-to-cart-btn {
    background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    color: #fff;
    border: 0;
    border-radius: 12px;
    padding: 15px 24px;
    font-weight: 900;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 8px 20px rgba(102, 126, 234, .3);
    transition: all .3s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    overflow: hidden;
}

.tera-add-to-cart-btn::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #764ba2 0%, #667eea 100%);
    opacity: 0;
    transition: opacity .3s ease;
}

.tera-add-to-cart-btn:hover::before {
    opacity: 1;
}

.tera-add-to-cart-btn span,
.tera-add-to-cart-btn i {
    position: relative;
    z-index: 1;
}

.tera-add-to-cart-btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(102, 126, 234, .4);
}

.tera-disabled-btn {
    background: #e2e8f0;
    color: #94a3b8;
    border: 0;
    border-radius: 12px;
    padding: 15px 24px;
    font-weight: 900;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    cursor: not-allowed;
}

/* INFO GRID */
.tera-info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 12px;
    margin-top: 20px;
}

.tera-info-item {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #f8fafc;
    padding: 15px;
    border-radius: 12px;
    border: 2px solid #e2e8f0;
    transition: all .3s ease;
}

.tera-info-item:hover {
    border-color: #667eea;
    transform: translateY(-1px);
}

.tera-info-item i {
    font-size: 20px;
    color: #667eea;
}

.tera-info-item div {
    display: flex;
    flex-direction: column;
}

.tera-info-item strong {
    font-size: 10px;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.5px;
}

.tera-info-item span {
    font-size: 12px;
    font-weight: 600;
    color: #0f172a;
    margin-top: 3px;
}

/* SUGGESTIONS */
.tera-suggestions-section {
    background: linear-gradient(135deg, #f8fbff 0%, #ffffff 100%);
    border: 1px solid #dbeafe;
    border-radius: 16px;
    padding: 25px;
    box-shadow: 0 8px 20px rgba(15, 23, 42, .08);
    margin-top: 25px;
}

.tera-suggestions-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
}

.tera-suggestions-icon {
    width: 40px;
    height: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #1d4ed8 0%, #1e40af 100%);
    color: #fff;
    box-shadow: 0 6px 15px rgba(29, 78, 216, .3);
}

.tera-suggestions-icon i {
    font-size: 16px;
}

.tera-suggestions-title {
    font-size: 20px;
    font-weight: 800;
    color: #0f172a;
    margin: 0;
}

.tera-suggestions-subtitle {
    margin-top: 3px;
    color: #64748b;
    font-size: 12px;
    font-weight: 600;
    margin-bottom: 0;
}

.tera-suggestion-card {
    background: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    overflow: hidden;
    height: 100%;
    display: flex;
    flex-direction: column;
    transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
}

.tera-suggestion-card:hover {
    transform: translateY(-3px);
    border-color: #bfdbfe;
    box-shadow: 0 12px 25px rgba(15, 23, 42, .1);
}

.tera-suggestion-image {
    position: relative;
    height: 150px;
    overflow: hidden;
    background: #f1f5f9;
}

.tera-suggestion-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .4s ease;
}

.tera-suggestion-card:hover .tera-suggestion-image img {
    transform: scale(1.05);
}

.tera-suggestion-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #eff6ff 0%, #dbeafe 100%);
    color: #64748b;
}

.tera-suggestion-placeholder i {
    font-size: 30px;
}

.tera-suggestion-category {
    position: absolute;
    top: 8px;
    left: 8px;
    background: rgba(15, 23, 42, .9);
    color: #fff;
    padding: 4px 8px;
    border-radius: 50px;
    font-size: 9px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.3px;
}

.tera-suggestion-content {
    padding: 15px;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.tera-suggestion-title {
    color: #0f172a;
    margin: 0 0 8px 0;
    line-height: 1.3;
    font-size: 14px;
    font-weight: 700;
    flex: 1;
}

.tera-suggestion-price {
    color: #1d4ed8;
    font-size: 16px;
    font-weight: 800;
    margin-bottom: 12px;
}

.tera-suggestion-actions {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

/* RESPONSIVE */
@media (max-width: 991px) {
    .tera-product-image-wrapper {
        position: static;
        margin-bottom: 20px;
        padding: 20px;
    }
    
    .tera-product-details {
        padding: 20px;
    }
    
    .tera-product-name {
        font-size: 22px;
    }
    
    .tera-price-value {
        font-size: 28px;
    }
    
    .tera-suggestions-section {
        padding: 20px 15px;
    }
}

@media (max-width: 576px) {
    .tera-product-details {
        padding: 20px 15px;
    }
    
    .tera-product-name {
        font-size: 20px;
    }
    
    .tera-price-section {
        padding: 15px;
    }
    
    .tera-price-value {
        font-size: 24px;
    }
    
    .tera-info-grid {
        grid-template-columns: 1fr;
    }

    .tera-suggestion-actions {
        flex-direction: row;
    }
}
</style>
{% endblock %}
