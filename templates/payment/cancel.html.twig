{% extends 'base.html.twig' %}

{% block title %}Paiement annulé{% endblock %}

{% block body %}
<div class="container mx-auto my-10 p-6 bg-yellow-100 rounded shadow-md text-center">
    <h1 class="text-3xl font-bold text-yellow-800 mb-4">⚠️ Paiement annulé</h1>
    <p class="text-lg mb-4">Votre paiement n'a pas été effectué.</p>
    <p class="mb-4">Vous pouvez réessayer ou contacter le support si nécessaire.</p>

    <a href="{{ path('boutique_panier') }}" class="inline-block px-6 py-2 bg-yellow-600 text-white font-semibold rounded hover:bg-yellow-700">
        Retour au panier
    </a>
</div>
{% endblock %}
