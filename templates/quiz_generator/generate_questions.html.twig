{# templates/quiz_generator/generate_questions.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Générer des questions par IA — {{ quiz.titre }}{% endblock %}

{% block stylesheets %}
{{ parent() }}
<style>
    /* ===== Variables ===== */
    :root {
        --ai-primary:    #6366f1;
        --ai-primary-h:  #4f46e5;
        --ai-success:    #22c55e;
        --ai-danger:     #ef4444;
        --ai-bg:         #f8fafc;
        --ai-card-bg:    #ffffff;
        --ai-border:     #e2e8f0;
        --ai-text:       #1e293b;
        --ai-muted:      #64748b;
        --ai-radius:     12px;
    }

    /* ===== Layout ===== */
    .ai-page { background: var(--ai-bg); min-height: 100vh; padding: 2rem 1rem; }

    .ai-hero {
        background: linear-gradient(135deg, #6366f1 0%, #8b5cf6 50%, #06b6d4 100%);
        border-radius: var(--ai-radius);
        padding: 2rem 2.5rem;
        color: #fff;
        margin-bottom: 2rem;
        display: flex;
        align-items: center;
        gap: 1.5rem;
    }
    .ai-hero-icon { font-size: 3rem; }
    .ai-hero h1 { font-size: 1.6rem; font-weight: 700; margin: 0; }
    .ai-hero p  { margin: 0.25rem 0 0; opacity: .85; }

    /* ===== Config Card ===== */
    .ai-card {
        background: var(--ai-card-bg);
        border: 1px solid var(--ai-border);
        border-radius: var(--ai-radius);
        padding: 2rem;
        margin-bottom: 1.5rem;
        box-shadow: 0 1px 3px rgba(0,0,0,.06);
    }
    .ai-card-title {
        font-size: 1.1rem; font-weight: 600; color: var(--ai-text);
        margin-bottom: 1.25rem; display: flex; align-items: center; gap: .5rem;
    }

    /* ===== Form ===== */
    .ai-form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    @media (max-width: 640px) { .ai-form-row { grid-template-columns: 1fr; } }

    .ai-field label {
        display: block; font-size: .85rem; font-weight: 600;
        color: var(--ai-muted); margin-bottom: .4rem; text-transform: uppercase; letter-spacing: .04em;
    }
    .ai-field input, .ai-field textarea, .ai-field select {
        width: 100%; padding: .65rem .9rem; border: 1.5px solid var(--ai-border);
        border-radius: 8px; font-size: .95rem; transition: border .2s;
        background: #fff; color: var(--ai-text);
    }
    .ai-field input:focus, .ai-field textarea:focus, .ai-field select:focus {
        outline: none; border-color: var(--ai-primary);
        box-shadow: 0 0 0 3px rgba(99,102,241,.15);
    }

    /* ===== Types checkboxes ===== */
    .type-grid { display: flex; gap: 1rem; flex-wrap: wrap; }
    .type-option { position: relative; }
    .type-option input[type=checkbox] { display: none; }
    .type-option label {
        display: flex; align-items: center; gap: .5rem;
        padding: .6rem 1.1rem; border: 1.5px solid var(--ai-border);
        border-radius: 50px; cursor: pointer; font-size: .9rem;
        font-weight: 600; transition: all .2s; color: var(--ai-muted);
        text-transform: none; letter-spacing: 0;
    }
    .type-option input:checked + label {
        background: var(--ai-primary); color: #fff; border-color: var(--ai-primary);
    }
    .type-option label:hover { border-color: var(--ai-primary); color: var(--ai-primary); }

    /* ===== Generate Button ===== */
    .ai-btn-generate {
        display: inline-flex; align-items: center; gap: .6rem;
        background: linear-gradient(135deg, var(--ai-primary), #8b5cf6);
        color: #fff; border: none; padding: .8rem 2rem;
        border-radius: 50px; font-size: 1rem; font-weight: 700;
        cursor: pointer; transition: all .2s; box-shadow: 0 4px 15px rgba(99,102,241,.35);
    }
    .ai-btn-generate:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 20px rgba(99,102,241,.45); }
    .ai-btn-generate:disabled { opacity: .6; cursor: not-allowed; }

    /* ===== Loading ===== */
    .ai-loading {
        display: none; text-align: center; padding: 3rem;
    }
    .ai-spinner {
        width: 50px; height: 50px; border: 4px solid #e2e8f0;
        border-top-color: var(--ai-primary); border-radius: 50%;
        animation: spin 0.8s linear infinite; margin: 0 auto 1rem;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ===== Preview Zone ===== */
    #previewZone { display: none; }

    .preview-header {
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 1rem; margin-bottom: 1.5rem;
    }
    .preview-header h3 { font-size: 1.1rem; font-weight: 700; margin: 0; }

    .preview-actions { display: flex; gap: .75rem; flex-wrap: wrap; }

    .ai-btn {
        display: inline-flex; align-items: center; gap: .4rem;
        padding: .55rem 1.25rem; border-radius: 50px;
        font-size: .9rem; font-weight: 600; cursor: pointer;
        border: 2px solid transparent; transition: all .2s;
    }
    .ai-btn-outline {
        background: transparent; border-color: var(--ai-primary);
        color: var(--ai-primary);
    }
    .ai-btn-outline:hover { background: var(--ai-primary); color: #fff; }
    .ai-btn-success {
        background: var(--ai-success); color: #fff;
    }
    .ai-btn-success:hover:not(:disabled) { background: #16a34a; }
    .ai-btn-success:disabled { opacity: .6; cursor: not-allowed; }

    /* ===== Question Cards ===== */
    .q-list { display: flex; flex-direction: column; gap: 1rem; }

    .q-card {
        border: 1.5px solid var(--ai-border);
        border-radius: var(--ai-radius); overflow: hidden;
        transition: border-color .2s, box-shadow .2s;
    }
    .q-card.selected { border-color: var(--ai-primary); box-shadow: 0 0 0 3px rgba(99,102,241,.12); }

    .q-header {
        display: flex; align-items: flex-start; gap: 1rem;
        padding: 1rem 1.25rem; cursor: pointer;
        background: #fafbff;
    }
    .q-card.selected .q-header { background: #eef2ff; }

    .q-checkbox {
        width: 20px; height: 20px; border: 2px solid #cbd5e1;
        border-radius: 5px; display: flex; align-items: center; justify-content: center;
        flex-shrink: 0; margin-top: 2px; transition: all .15s;
    }
    .q-card.selected .q-checkbox { background: var(--ai-primary); border-color: var(--ai-primary); }
    .q-checkbox-icon { display: none; color: #fff; font-size: .85rem; }
    .q-card.selected .q-checkbox-icon { display: block; }

    .q-meta { flex: 1; }
    .q-enonce { font-weight: 600; font-size: .98rem; color: var(--ai-text); line-height: 1.45; }
    .q-badges { display: flex; gap: .5rem; margin-top: .4rem; flex-wrap: wrap; }
    .badge {
        display: inline-block; padding: .2rem .65rem; border-radius: 50px;
        font-size: .75rem; font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
    }
    .badge-qcm        { background: #ede9fe; color: #7c3aed; }
    .badge-vrai_faux  { background: #d1fae5; color: #065f46; }
    .badge-texte      { background: #fef9c3; color: #854d0e; }
    .badge-points     { background: #f1f5f9; color: var(--ai-muted); }

    .q-toggle {
        color: var(--ai-muted); font-size: 1.1rem; transition: transform .2s; flex-shrink: 0;
    }
    .q-card.open .q-toggle { transform: rotate(180deg); }

    /* ===== Question Detail ===== */
    .q-detail { display: none; padding: 1rem 1.25rem 1.25rem; border-top: 1px solid var(--ai-border); }
    .q-card.open .q-detail { display: block; }

    .reponses-list { display: flex; flex-direction: column; gap: .5rem; margin-bottom: 1rem; }
    .reponse-item {
        display: flex; align-items: center; gap: .6rem;
        padding: .55rem .9rem; border-radius: 8px; font-size: .9rem;
        background: #f8fafc; border: 1px solid var(--ai-border);
    }
    .reponse-item.correct { background: #f0fdf4; border-color: #86efac; }
    .reponse-icon { font-size: 1rem; flex-shrink: 0; }

    .q-explication {
        background: #fffbeb; border: 1px solid #fde68a;
        border-radius: 8px; padding: .7rem 1rem; font-size: .88rem; color: #78350f;
    }
    .q-explication strong { display: block; margin-bottom: .2rem; }

    /* ===== Error ===== */
    .ai-error {
        display: none; background: #fef2f2; border: 1px solid #fecaca;
        border-radius: var(--ai-radius); padding: 1rem 1.25rem;
        color: #991b1b; font-size: .9rem; margin-bottom: 1.5rem;
    }

    /* ===== Toast ===== */
    .ai-toast {
        position: fixed; bottom: 2rem; right: 2rem; z-index: 9999;
        background: var(--ai-text); color: #fff; padding: .8rem 1.5rem;
        border-radius: 50px; font-weight: 600; font-size: .9rem;
        box-shadow: 0 4px 20px rgba(0,0,0,.3);
        transform: translateY(100px); opacity: 0;
        transition: all .35s cubic-bezier(.34,1.56,.64,1);
    }
    .ai-toast.show { transform: translateY(0); opacity: 1; }
    .ai-toast.success { background: var(--ai-success); }
    .ai-toast.error   { background: var(--ai-danger); }
</style>
{% endblock %}

{% block body %}
<div class="ai-page">
    <div class="container" style="max-width: 860px; margin: 0 auto;">

        {# Breadcrumb #}
        <nav aria-label="breadcrumb" style="margin-bottom: 1.5rem;">
            <ol class="breadcrumb" style="background:none;padding:0;font-size:.85rem;color:var(--ai-muted);">
                <li class="breadcrumb-item">
                    <a href="{{ path('question_index', {formationId: formation.id, quizId: quiz.id}) }}"
                       style="color:var(--ai-primary);text-decoration:none;">
                        ← Retour aux questions
                    </a>
                </li>
                <li class="breadcrumb-item active">Génération IA</li>
            </ol>
        </nav>

        {# Hero #}
        <div class="ai-hero">
            <div class="ai-hero-icon">🤖</div>
            <div>
                <h1>Génération automatique de questions</h1>
                <p>Quiz : <strong>{{ quiz.titre }}</strong> &nbsp;|&nbsp; Formation : {{ formation.titre }}</p>
            </div>
        </div>

        {# Error Zone #}
        <div class="ai-error" id="errorZone">
            <strong>⚠️ Erreur :</strong> <span id="errorMsg"></span>
        </div>

        {# Config Card #}
        <div class="ai-card">
            <div class="ai-card-title">⚙️ Configuration de la génération</div>

            <div class="ai-field" style="margin-bottom:1.25rem;">
                <label for="sujet">📚 Sujet / Contexte</label>
                <textarea id="sujet" rows="3"
                    placeholder="Ex: Les bases de HTML et CSS pour les débutants, les balises fondamentales, les propriétés CSS essentielles..."
                    style="resize:vertical;">{{ quiz.titre }}</textarea>
                <small style="color:var(--ai-muted);font-size:.8rem;">
                    Plus le sujet est détaillé, meilleure sera la qualité des questions.
                </small>
            </div>

            <div class="ai-form-row" style="margin-bottom:1.25rem;">
                <div class="ai-field">
                    <label for="nombre">🔢 Nombre de questions</label>
                    <input type="number" id="nombre" value="5" min="1" max="20">
                </div>
                <div class="ai-field">
                    <label for="points">⭐ Points par question</label>
                    <input type="number" id="points" value="1" min="1" max="100">
                </div>
            </div>

            <div class="ai-field" style="margin-bottom:1.75rem;">
                <label>📋 Types de questions</label>
                <div class="type-grid">
                    <div class="type-option">
                        <input type="checkbox" id="type-qcm" value="qcm" checked>
                        <label for="type-qcm">🔵 QCM</label>
                    </div>
                    <div class="type-option">
                        <input type="checkbox" id="type-vf" value="vrai_faux">
                        <label for="type-vf">✅ Vrai / Faux</label>
                    </div>
                    <div class="type-option">
                        <input type="checkbox" id="type-texte" value="texte">
                        <label for="type-texte">✏️ Texte libre</label>
                    </div>
                </div>
            </div>

            <div style="text-align:center;">
                <button class="ai-btn-generate" id="btnGenerate" onclick="generateQuestions()">
                    <span id="btnIcon">✨</span>
                    <span id="btnLabel">Générer avec Gemini AI</span>
                </button>
            </div>
        </div>

        {# Loading #}
        <div class="ai-loading ai-card" id="loadingZone">
            <div class="ai-spinner"></div>
            <p style="color:var(--ai-muted);font-weight:600;">Gemini génère vos questions…</p>
            <p style="color:var(--ai-muted);font-size:.85rem;">Cela prend généralement 5 à 15 secondes.</p>
        </div>

        {# Preview Zone #}
        <div id="previewZone">
            <div class="ai-card">
                <div class="preview-header">
                    <h3>📋 Questions générées (<span id="previewCount">0</span>)</h3>
                    <div class="preview-actions">
                        <button class="ai-btn ai-btn-outline" onclick="toggleSelectAll()">
                            <span id="selectAllIcon">☑️</span>
                            <span id="selectAllLabel">Tout sélectionner</span>
                        </button>
                        <button class="ai-btn ai-btn-outline" onclick="generateQuestions()">
                            🔄 Regénérer
                        </button>
                        <button class="ai-btn ai-btn-success" id="btnSave" onclick="saveQuestions()">
                            💾 Sauvegarder (<span id="selectedCount">0</span>)
                        </button>
                    </div>
                </div>

                <div class="q-list" id="questionList"></div>
            </div>
        </div>

    </div>
</div>

{# Toast Notification #}
<div class="ai-toast" id="toast"></div>

{% block javascripts %}
{{ parent() }}
<script>
const PREVIEW_URL = "{{ path('quiz_generate_preview', {formationId: formation.id, quizId: quiz.id}) }}";
const SAVE_URL    = "{{ path('quiz_generate_save',    {formationId: formation.id, quizId: quiz.id}) }}";

let generatedQuestions = [];

// ======== GÉNÉRATION =========
async function generateQuestions() {
    const sujet  = document.getElementById('sujet').value.trim();
    const nombre = parseInt(document.getElementById('nombre').value) || 5;
    const points = parseInt(document.getElementById('points').value) || 1;

    const types = ['qcm', 'vrai_faux', 'texte'].filter(t => {
        const el = document.querySelector(`input[value="${t}"]`);
        return el && el.checked;
    });

    if (!sujet) { showToast('Veuillez saisir un sujet.', 'error'); return; }
    if (types.length === 0) { showToast('Choisissez au moins un type de question.', 'error'); return; }

    setLoading(true);
    hideError();
    document.getElementById('previewZone').style.display = 'none';

    try {
        const resp = await fetch(PREVIEW_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ sujet, nombre, types, points })
        });

        const data = await resp.json();

        if (!data.success) throw new Error(data.error || 'Erreur inconnue');

        generatedQuestions = data.questions;
        renderQuestions(generatedQuestions);
        document.getElementById('previewZone').style.display = 'block';
        showToast(`✅ ${data.count} question(s) générée(s) !`, 'success');

    } catch (err) {
        showError(err.message);
    } finally {
        setLoading(false);
    }
}

// ======== RENDU =========
function renderQuestions(questions) {
    const list = document.getElementById('questionList');
    document.getElementById('previewCount').textContent = questions.length;
    list.innerHTML = '';

    questions.forEach((q, i) => {
        const card = document.createElement('div');
        card.className = 'q-card selected';
        card.dataset.index = i;

        const badgeClass = { qcm: 'badge-qcm', vrai_faux: 'badge-vrai_faux', texte: 'badge-texte' }[q.type] || 'badge-qcm';
        const typeLabel  = { qcm: 'QCM', vrai_faux: 'Vrai/Faux', texte: 'Texte' }[q.type] || q.type;

        let reponsesHtml = '';
        if (q.reponses && q.reponses.length > 0) {
            reponsesHtml = `
                <div class="reponses-list">
                    ${q.reponses.map(r => `
                        <div class="reponse-item ${r.estCorrecte ? 'correct' : ''}">
                            <span class="reponse-icon">${r.estCorrecte ? '✅' : '○'}</span>
                            ${escHtml(r.texte)}
                        </div>
                    `).join('')}
                </div>`;
        }

        const explicHtml = q.explication ? `
            <div class="q-explication">
                <strong>💡 Explication</strong>
                ${escHtml(q.explication)}
            </div>` : '';

        card.innerHTML = `
            <div class="q-header" onclick="toggleCard(this.closest('.q-card'))">
                <div class="q-checkbox">
                    <span class="q-checkbox-icon">✓</span>
                </div>
                <div class="q-meta">
                    <div class="q-enonce">${escHtml(q.enonce)}</div>
                    <div class="q-badges">
                        <span class="badge ${badgeClass}">${typeLabel}</span>
                        <span class="badge badge-points">⭐ ${q.points} pt${q.points > 1 ? 's' : ''}</span>
                        ${q.reponses.length > 0 ? `<span class="badge badge-points">${q.reponses.length} réponses</span>` : ''}
                    </div>
                </div>
                <span class="q-toggle">▼</span>
            </div>
            <div class="q-detail">
                ${reponsesHtml}
                ${explicHtml}
            </div>`;

        list.appendChild(card);
    });

    updateSelectedCount();
}

// ======== TOGGLE CARTE =========
function toggleCard(card) {
    // Clic sur le header : basculer sélection si clic sur checkbox zone, sinon basculer open
    card.classList.toggle('selected');
    card.classList.toggle('open');
    updateSelectedCount();
}

// ======== SELECT ALL =========
let allSelected = true;
function toggleSelectAll() {
    allSelected = !allSelected;
    document.querySelectorAll('.q-card').forEach(c => {
        allSelected ? c.classList.add('selected') : c.classList.remove('selected');
    });
    document.getElementById('selectAllIcon').textContent  = allSelected ? '☑️' : '⬜';
    document.getElementById('selectAllLabel').textContent = allSelected ? 'Tout désélectionner' : 'Tout sélectionner';
    updateSelectedCount();
}

function updateSelectedCount() {
    const n = document.querySelectorAll('.q-card.selected').length;
    document.getElementById('selectedCount').textContent = n;
    document.getElementById('btnSave').disabled = n === 0;
}

// ======== SAUVEGARDE =========
async function saveQuestions() {
    const selectedCards = [...document.querySelectorAll('.q-card.selected')];
    if (selectedCards.length === 0) { showToast('Aucune question sélectionnée.', 'error'); return; }

    const toSave = selectedCards.map(c => generatedQuestions[parseInt(c.dataset.index)]);

    document.getElementById('btnSave').disabled = true;

    try {
        const resp = await fetch(SAVE_URL, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ questions: toSave })
        });

        const data = await resp.json();

        if (!data.success) throw new Error(data.error || 'Erreur lors de la sauvegarde.');

        showToast(`✅ ${data.savedCount} question(s) sauvegardée(s) !`, 'success');

        setTimeout(() => { window.location.href = data.redirectUrl; }, 1200);

    } catch (err) {
        showToast(err.message, 'error');
        document.getElementById('btnSave').disabled = false;
    }
}

// ======== HELPERS =========
function setLoading(on) {
    document.getElementById('loadingZone').style.display = on ? 'block' : 'none';
    const btn = document.getElementById('btnGenerate');
    btn.disabled = on;
    document.getElementById('btnIcon').textContent  = on ? '⏳' : '✨';
    document.getElementById('btnLabel').textContent = on ? 'Génération en cours…' : 'Générer avec Gemini AI';
}

function showError(msg) {
    document.getElementById('errorZone').style.display = 'block';
    document.getElementById('errorMsg').textContent = msg;
}
function hideError() { document.getElementById('errorZone').style.display = 'none'; }

function escHtml(str) {
    return String(str)
        .replace(/&/g,'&amp;').replace(/</g,'&lt;')
        .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

let toastTimer;
function showToast(msg, type = '') {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = `ai-toast ${type} show`;
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => { t.classList.remove('show'); }, 3500);
}
</script>
{% endblock %}
{% endblock %}
