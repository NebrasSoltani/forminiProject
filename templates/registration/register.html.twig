                            <div class="row">
                                <div class="col-md-6">
                                    <div class="form-group">
                                        {{ form_label(registrationForm.siteWeb, null, {'label_attr': {'class': 'form-label'}}) }}
                                        {{ form_widget(registrationForm.siteWeb, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': 'https://votre-societe.com'
