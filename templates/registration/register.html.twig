                                <path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
                                <path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
                                <path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
                            </svg>
                            S'inscrire avec Google
                        </a>
                        
                        <a href="{{ path('oauth_github') }}" class="btn btn-oauth btn-github">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
                            </svg>
                            S'inscrire avec GitHub
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Password visibility toggle
    document.querySelectorAll('.toggle-password').forEach(btn => {
        btn.addEventListener('click', function() {
            const input = this.previousElementSibling;
            const isPassword = input.type === 'password';
            
            input.type = isPassword ? 'text' : 'password';
            this.textContent = isPassword ? '🙈' : '👁️';
            this.setAttribute('aria-label', isPassword ? 'Cacher le mot de passe' : 'Afficher le mot de passe');
            
            // Add visual feedback
            input.classList.add('is-invalid');
            setTimeout(() => input.classList.remove('is-invalid'), 300);
        });
    });

    // Role-based fields management
    const roleSelect = document.querySelector('select[name*="roleUtilisateur"]');
    const formateurFields = document.getElementById('formateur-fields');
    const apprenantFields = document.getElementById('apprenant-fields');
    const societeFields = document.getElementById('societe-fields');
    const sections = [formateurFields, apprenantFields, societeFields];

    function showRoleFields() {
        // Hide all sections first
        sections.forEach(section => {
            section.style.display = 'none';
            section.classList.remove('visible');
        });

        // Show relevant section
        const selectedRole = roleSelect.value.trim().toLowerCase();
        let targetSection = null;
        
        if (selectedRole === 'formateur') targetSection = formateurFields;
        else if (selectedRole === 'apprenant') targetSection = apprenantFields;
        else if (selectedRole === 'societe') targetSection = societeFields;

        if (targetSection) {
            targetSection.style.display = 'block';
            setTimeout(() => targetSection.classList.add('visible'), 10);
            
            // Reinitialize phone verification if switching to apprenant role
            if (selectedRole === 'apprenant') {
                setTimeout(() => initializePhoneVerification(), 100);
            }
        }
    }

    if (roleSelect) {
        roleSelect.addEventListener('change', showRoleFields);
        showRoleFields(); // Initialize on load
    }

    // File upload name display
    document.querySelectorAll('.file-input').forEach(input => {
        const fileNameDisplay = input.closest('.custom-file-upload').querySelector('.file-name');
        
        input.addEventListener('change', function() {
            if (this.files.length > 0) {
                const fileName = this.files[0].name.length > 30 
                    ? this.files[0].name.substring(0, 27) + '...' 
                    : this.files[0].name;
                fileNameDisplay.textContent = fileName;
                fileNameDisplay.style.color = '#2b6cb0';
                fileNameDisplay.style.fontStyle = 'normal';
            } else {
                fileNameDisplay.textContent = 'Aucun fichier sélectionné';
                fileNameDisplay.style.color = '#718096';
                fileNameDisplay.style.fontStyle = 'italic';
            }
        });
    });

    // Phone verification functionality (only for apprenant role)
    let phoneInput, verifyPhoneBtn, phoneVerificationStatus;
    let phoneVerified = false;

    function initializePhoneVerification() {
        phoneInput = document.getElementById('phone-input');
        verifyPhoneBtn = document.getElementById('verify-phone-btn');
        phoneVerificationStatus = document.getElementById('phone-verification-status');

        // Only initialize if elements exist
        if (phoneInput && verifyPhoneBtn && phoneVerificationStatus) {
            // Format phone input
            phoneInput.addEventListener('input', function() {
                this.value = this.value.replace(/\D/g, '');
                
                // Reset verification status if phone changes
                if (phoneVerified) {
                    phoneVerified = false;
                    verifyPhoneBtn.textContent = '📱 Vérifier le numéro';
                    verifyPhoneBtn.classList.remove('btn-success');
                    verifyPhoneBtn.classList.add('btn-outline-primary');
                    phoneVerificationStatus.innerHTML = '';
                }
            });

            // Phone verification
            verifyPhoneBtn.addEventListener('click', async function() {
                const phone = phoneInput.value.trim();
                
                if (!phone || phone.length !== 8) {
                    phoneVerificationStatus.innerHTML = '<div class="alert alert-danger">Veuillez entrer un numéro de téléphone valide (8 chiffres)</div>';
                    return;
                }

                verifyPhoneBtn.disabled = true;
                verifyPhoneBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Envoi en cours...';
                        'Content-Type': 'application/json',
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify({ phone: phone })
                });

                const result = await response.json();

                if (result.success) {
                    phoneVerificationStatus.innerHTML = `
                        <div class="alert alert-success">
                            ✅ ${result.message}
                            <div class="mt-2">
                                <input type="text" class="form-control form-control-sm" id="verification-code" 
                                       placeholder="Entrez le code à 6 chiffres" maxlength="6" pattern="[0-9]{6}">
                                <button type="button" class="btn btn-sm btn-success mt-2" id="confirm-code-btn">
                                    Confirmer le code
                                </button>
                            </div>
                        </div>`;
                    
                    // Add code confirmation functionality
                    const confirmCodeBtn = document.getElementById('confirm-code-btn');
                    const verificationCodeInput = document.getElementById('verification-code');
                    
                    if (confirmCodeBtn) {
                        confirmCodeBtn.addEventListener('click', async function() {
                            if (!verificationCodeInput) {
                                phoneVerificationStatus.innerHTML += '<div class="alert alert-danger mt-2">Champ de code non trouvé</div>';
                                return;
                            }
                            
                            const code = verificationCodeInput.value.trim();
                            
                            if (!code || code.length !== 6) {
                                phoneVerificationStatus.innerHTML += '<div class="alert alert-danger mt-2">Veuillez entrer un code à 6 chiffres</div>';
                                return;
                            }

                            confirmCodeBtn.disabled = true;
                            confirmCodeBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2"></span>Vérification...';

                            try {
                                const verifyResponse = await fetch('/api/phone-verification/verify', {
                                    method: 'POST',
                                    headers: {
                                        'Content-Type': 'application/json',
                                        'X-Requested-With': 'XMLHttpRequest'
                                    },
                                    body: JSON.stringify({ code: code })
                                });

                                const verifyResult = await verifyResponse.json();

                                if (verifyResult.success) {
                                    phoneVerified = true;
                                    verifyPhoneBtn.textContent = '✅ Téléphone vérifié';
                                    verifyPhoneBtn.classList.remove('btn-outline-primary');
                                    verifyPhoneBtn.classList.add('btn-success');
                                    phoneVerificationStatus.innerHTML = '<div class="alert alert-success">✅ Téléphone vérifié avec succès!</div>';
                                } else {
                                    phoneVerificationStatus.innerHTML += `<div class="alert alert-danger mt-2">${verifyResult.message}</div>`;
                                }
                            } catch (error) {
                                phoneVerificationStatus.innerHTML += '<div class="alert alert-danger mt-2">Erreur de connexion. Veuillez réessayer.</div>';
                            } finally {
                                confirmCodeBtn.disabled = false;
                                confirmCodeBtn.innerHTML = 'Confirmer le code';
                            }
                        });
                    }

                } else {
                    phoneVerificationStatus.innerHTML = `<div class="alert alert-danger">${result.message}</div>`;
                }
            } catch (error) {
                phoneVerificationStatus.innerHTML = '<div class="alert alert-danger">Erreur de connexion. Veuillez réessayer.</div>';
            } finally {
                verifyPhoneBtn.disabled = false;
                verifyPhoneBtn.innerHTML = '📱 Vérifier le numéro';
            }
        });
    }

    // Add custom interest for apprenant
    const addInterestBtn = document.getElementById('addInterestBtn');
    const autreInput = document.getElementById('autreCentreInteret');
    const checkboxesContainer = document.getElementById('domainesInteretCheckboxes');
    
    if (addInterestBtn && autreInput && checkboxesContainer) {
        function addCustomInterest() {
            const value = autreInput.value.trim();
            if (!value) return;
            
            // Check if already exists
            const existing = Array.from(checkboxesContainer.querySelectorAll('input[type="checkbox"]'))
                .some(cb => cb.value.toLowerCase() === value.toLowerCase());
            
            if (existing) {
                autreInput.value = '';
                return;
            }
            
            // Create new checkbox
            const id = 'domainesInteret_custom_' + Date.now();
            const div = document.createElement('div');
            div.className = 'form-check';
            
            const input = document.createElement('input');
            input.type = 'checkbox';
            input.name = 'registration_form[domainesInteret][]';
            input.value = value;
            input.id = id;
            input.className = 'form-check-input';
            input.checked = true;
            
            const label = document.createElement('label');
            label.className = 'form-check-label';
            label.htmlFor = id;
            label.textContent = value;
            
            div.appendChild(input);
            div.appendChild(label);
            checkboxesContainer.appendChild(div);
            
            // Clear input and provide feedback
            autreInput.value = '';
            autreInput.focus();
            
            // Visual feedback
            autreInput.classList.add('is-valid');
            setTimeout(() => autreInput.classList.remove('is-valid'), 1500);
        }
        
        addInterestBtn.addEventListener('click', addCustomInterest);
        autreInput.addEventListener('keypress', (e) => {
            if (e.key === 'Enter') addCustomInterest();
        });
    }

    // Turnstile callbacks
    window.onTurnstileSuccess = function(token) {
        const responseElement = document.getElementById('cf-turnstile-response');
        if (responseElement) {
            responseElement.value = token;
        }
        const errorElement = document.getElementById('turnstile-error');
        if (errorElement) {
            errorElement.style.display = 'none';
        }
        const submitBtn = document.getElementById('register-submit-btn');
        if (submitBtn) {
            submitBtn.disabled = false;
        }
    };

    window.onTurnstileExpired = function() {
        const responseElement = document.getElementById('cf-turnstile-response');
        if (responseElement) {
            responseElement.value = '';
        }
        const submitBtn = document.getElementById('register-submit-btn');
        if (submitBtn) {
            submitBtn.disabled = true;
        }
    };

    window.onTurnstileError = function() {
        const responseElement = document.getElementById('cf-turnstile-response');
        if (responseElement) {
            responseElement.value = '';
        }
        const errorElement = document.getElementById('turnstile-error');
        if (errorElement) {
            errorElement.style.display = 'block';
        }
        const submitBtn = document.getElementById('register-submit-btn');
        if (submitBtn) {
            submitBtn.disabled = true;
        }
    };

    // Form validation
    const registrationForm = document.querySelector('form[name="registration_form"]');
    
    if (registrationForm) {
        registrationForm.addEventListener('submit', function(e) {
            const responseElement = document.getElementById('cf-turnstile-response');
            const turnstileResponse = responseElement ? responseElement.value : '';
            
            if (!turnstileResponse) {
                e.preventDefault();
                const errorElement = document.getElementById('turnstile-error');
                if (errorElement) {
                    errorElement.style.display = 'block';
                    errorElement.textContent = 'Veuillez compléter la vérification de sécurité.';
                }
                return false;
            }
        });
    }
});
</script>
{% endblock %}