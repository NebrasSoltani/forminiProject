                                        <button type="button" class="btn btn-sm btn-outline-primary" id="verify-phone-btn">
                                            📱 Vérifier le numéro
                                        </button>
                                        <div id="phone-verification-status" class="mt-2"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
