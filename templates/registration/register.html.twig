                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(registrationForm.plainPassword.second, 'Confirmer le mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                                    <div class="input-group">
                                        {{ form_widget(registrationForm.plainPassword.second, {
                                            'attr': {
                                                'class': 'form-control form-control-lg password-field',
                                                'placeholder': '••••••••',
                                                'autocomplete': 'new-password'
                                            }
                                        }) }}
                                        <button class="btn toggle-password" type="button" aria-label="Afficher le mot de passe">👁️</button>
                                    </div>
                                    {{ form_errors(registrationForm.plainPassword.second) }}
