                                            'placeholder': 'Ex: Dupont'
                                        }
                                    }) }}
                                    {{ form_errors(registrationForm.nom) }}
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(registrationForm.prenom, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(registrationForm.prenom, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': 'Ex: Marie'
                                        }
                                    }) }}
                                    {{ form_errors(registrationForm.prenom) }}
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(registrationForm.email, {
                                        'attr': {
                                            'class': 'form-control',
                                            'placeholder': 'votre@email.com',
                                            'autocomplete': 'email'
                                        }
                                    }) }}
                                    {{ form_errors(registrationForm.email) }}
                                    <small class="form-text">Nous ne partagerons jamais votre email</small>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    {{ form_label(registrationForm.telephone, 'Téléphone', {'label_attr': {'class': 'form-label'}}) }}
                                    <div class="input-group">
                                        <span class="input-group-text">+216</span>
                                        {{ form_widget(registrationForm.telephone, {
                                            'attr': {
                                                'class': 'form-control',
                                                'placeholder': 'XX XXX XXX',
                                                'pattern': '[0-9]{8}',
                                                'maxlength': '8',
                                                'id': 'phone-input'
                                            }
                                        }) }}
                                    </div>
                                    {{ form_errors(registrationForm.telephone) }}
