{% extends 'base.html.twig' %}

{% block title %}Statistiques des Événements{% endblock %}

{% block body %}
<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0"><i class="mdi mdi-chart-bar"></i> Statistiques des Événements</h4>
                    <div class="page-title-right">
                        <a href="{{ path('admin_evenement_index') }}" class="btn btn-secondary">
                            <i class="mdi mdi-arrow-left"></i> Retour
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Cartes statistiques principales #}
        <div class="row">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-primary shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">Total Événements</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.total }}</div>
                            </div>
                            <div class="col-auto"><i class="mdi mdi-calendar-multiple text-primary" style="font-size: 2rem;"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-success shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-success text-uppercase mb-1">Actifs</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.actifs }}</div>
                            </div>
                            <div class="col-auto"><i class="mdi mdi-check-circle text-success" style="font-size: 2rem;"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-info shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">À Venir</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.a_venir }}</div>
                            </div>
                            <div class="col-auto"><i class="mdi mdi-clock-outline text-info" style="font-size: 2rem;"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-secondary shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-secondary text-uppercase mb-1">Passés</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.passes }}</div>
                            </div>
                            <div class="col-auto"><i class="mdi mdi-history text-secondary" style="font-size: 2rem;"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-warning shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">En Cours</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.en_cours }}</div>
                            </div>
                            <div class="col-auto"><i class="mdi mdi-play-circle text-warning" style="font-size: 2rem;"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-danger shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">Réactions Live</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ liveStats.total_reactions }}</div>
                            </div>
                            <div class="col-auto"><i class="mdi mdi-heart text-danger" style="font-size: 2rem;"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-dark shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-dark text-uppercase mb-1">Commentaires Live</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ liveStats.total_comments }}</div>
                            </div>
                            <div class="col-auto"><i class="mdi mdi-message-text text-dark" style="font-size: 2rem;"></i></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-xl-3 col-md-6 mb-4">
                <div class="card border-left-info shadow h-100 py-2">
                    <div class="card-body">
                        <div class="row no-gutters align-items-center">
                            <div class="col mr-2">
                                <div class="text-xs font-weight-bold text-info text-uppercase mb-1">Moyenne Places</div>
                                <div class="h5 mb-0 font-weight-bold text-gray-800">{{ stats.moyenne_places }}</div>
                            </div>
                            <div class="col-auto"><i class="mdi mdi-account-multiple text-info" style="font-size: 2rem;"></i></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        {# Graphiques et Top 5 #}
        <div class="row">
            <div class="col-lg-4 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-primary text-white py-2">
                        <h6 class="mb-0 fs-6"><i class="mdi mdi-chart-pie"></i> Répartition par Type</h6>
                    </div>
                    <div class="card-body p-2">
                        {% if stats.par_type|length > 0 %}
                            <canvas id="chartType" style="max-height: 200px;"></canvas>
                            <div class="table-responsive mt-2">
                                <table class="table table-sm mb-0" style="font-size: 0.8rem;">
                                    <tbody>
                                        {% for item in stats.par_type|slice(0, 4) %}
                                            <tr>
                                                <td><span class="badge bg-soft-info text-info">{{ item.type }}</span></td>
                                                <td class="text-end"><strong>{{ item.nombre }}</strong></td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        {% else %}
                            <p class="text-muted text-center py-4">Aucune donnée</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-success text-white py-2">
                        <h6 class="mb-0 fs-6"><i class="mdi mdi-trophy"></i> Top Capacité</h6>
                    </div>
                    <div class="card-body p-2">
                        {% if topEvenements|length > 0 %}
                            <div class="list-group list-group-flush">
                                {% for evenement in topEvenements|slice(0, 4) %}
                                    <div class="list-group-item px-0 py-2 border-0">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div class="text-truncate" style="max-width: 150px;">
                                                <span class="fw-bold d-block text-truncate" style="font-size: 0.85rem;">{{ evenement.titre }}</span>
                                            </div>
                                            <span class="badge bg-primary-soft text-primary">{{ evenement.nombrePlaces }} pl.</span>
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-muted text-center py-4">Aucun événement</p>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="col-lg-4 mb-4">
                <div class="card shadow h-100">
                    <div class="card-header bg-info text-white py-2">
                        <h6 class="mb-0 fs-6"><i class="mdi mdi-chart-bar"></i> État des Événements</h6>
                    </div>
                    <div class="card-body p-2">
                        <canvas id="chartStatut" style="max-height: 250px;"></canvas>
                    </div>
                </div>
            </div>
        </div>

        {# Statistiques Live Détaillées #}
        <div class="row">
            <div class="col-lg-8">
                <div class="card shadow mb-4">
                    <div class="card-header bg-danger text-white py-2">
                        <h6 class="mb-0 fs-6"><i class="mdi mdi-fire"></i> Engagement Live par Événement</h6>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-sm table-hover align-middle mb-0" style="font-size: 0.85rem;">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-3">Événement</th>
                                        <th class="text-center">Interactions</th>
                                        <th class="text-center">Engagement</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set events = {} %}
                                    {% for rs in liveStats.reactions_by_event %}
                                        {% set events = events|merge({ (rs.event_title): { 'reactions': rs.reaction_count, 'comments': 0 } }) %}
                                    {% endfor %}
                                    {% for cs in liveStats.comments_by_event %}
                                        {% if events[cs.event_title] is defined %}
                                            {% set events = events|merge({ (cs.event_title): { 'reactions': events[cs.event_title].reactions, 'comments': cs.comment_count } }) %}
                                        {% else %}
                                            {% set events = events|merge({ (cs.event_title): { 'reactions': 0, 'comments': cs.comment_count } }) %}
                                        {% endif %}
                                    {% endfor %}

                                    {% for title, data in events %}
                                        <tr>
                                            <td class="ps-3"><strong>{{ title }}</strong></td>
                                            <td class="text-center">
                                                <span class="text-danger small">{{ data.reactions }} ❤️</span> / 
                                                <span class="text-primary small">{{ data.comments }} 💬</span>
                                            </td>
                                            <td class="text-center px-3" style="width: 200px;">
                                                {% set total = data.reactions + data.comments %}
                                                {% set perc = (total > 0 ? (total / (liveStats.total_reactions + liveStats.total_comments + 1) * 100) : 0) %}
                                                <div class="progress" style="height: 6px;">
                                                    <div class="progress-bar bg-warning" role="progressbar" style="width: {{ perc|number_format(0) }}%"></div>
                                                </div>
                                            </td>
                                        </tr>
                                    {% else %}
                                        <tr><td colspan="3" class="text-center text-muted py-3">Aucune donnée live</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                <div class="card shadow mb-4">
                    <div class="card-header bg-soft-danger border-danger text-danger py-2">
                        <h6 class="mb-0 fs-6">Emojis les plus utilisés</h6>
                    </div>
                    <div class="card-body p-2 d-flex align-items-center justify-content-center" style="height: 250px;">
                        <canvas id="chartLiveEmojis"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{# Chart.js #}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    // Graphique par type (Pie Chart)
    {% if stats.par_type|length > 0 %}
    const ctxType = document.getElementById('chartType').getContext('2d');
    new Chart(ctxType, {
        type: 'pie',
        data: {
            labels: [{% for item in stats.par_type %}'{{ item.type }}'{% if not loop.last %},{% endif %}{% endfor %}],
            datasets: [{
                data: [{% for item in stats.par_type %}{{ item.nombre }}{% if not loop.last %},{% endif %}{% endfor %}],
                backgroundColor: [
                    '#FF6384', '#36A2EB', '#FFCE56', '#4BC0C0', 
                    '#9966FF', '#FF9F40', '#FF6384', '#C9CBCF'
                ]
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
                legend: {
                    position: 'bottom'
                }
            }
        }
    });
    {% endif %}

    // Graphique de statut (Bar Chart)
    const ctxStatut = document.getElementById('chartStatut').getContext('2d');
    new Chart(ctxStatut, {
        type: 'bar',
        data: {
            labels: ['À Venir', 'En Cours', 'Passés', 'Actifs', 'Total'],
            datasets: [{
                label: 'Nombre d\'événements',
                data: [
                    {{ stats.a_venir }},
                    {{ stats.en_cours }},
                    {{ stats.passes }},
                    {{ stats.actifs }},
                    {{ stats.total }}
                ],
                backgroundColor: [
                    'rgba(23, 162, 184, 0.8)',
                    'rgba(255, 193, 7, 0.8)',
                    'rgba(108, 117, 125, 0.8)',
                    'rgba(40, 167, 69, 0.8)',
                    'rgba(0, 123, 255, 0.8)'
                ],
                borderColor: [
                    'rgba(23, 162, 184, 1)',
                    'rgba(255, 193, 7, 1)',
                    'rgba(108, 117, 125, 1)',
                    'rgba(40, 167, 69, 1)',
                    'rgba(0, 123, 255, 1)'
                ],
                borderWidth: 1
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: true,
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1
                    }
                }
            },
            plugins: {
                legend: {
                    display: false
                }
            }
        }
    });

    // Graphique des Emojis (Doughnut Chart)
    const ctxEmoji = document.getElementById('chartLiveEmojis').getContext('2d');
    new Chart(ctxEmoji, {
        type: 'doughnut',
        data: {
            labels: [{% for item in liveStats.reaction_distribution %}'{{ item.type }}'{% if not loop.last %},{% endif %}{% endfor %}],
            datasets: [{
                data: [{% for item in liveStats.reaction_distribution %}{{ item.count }}{% if not loop.last %},{% endif %}{% endfor %}],
                backgroundColor: [
                    '#e74a3b', // Red (Love/Anger)
                    '#f6c23e', // Yellow (Fire/Sun)
                    '#4e73df', // Blue (Sad/Like)
                    '#1cc88a', // Green (Bravo)
                    '#36b9cc', // Cyan
                    '#858796', // Gray
                    '#6f42c1', // Purple
                    '#fd7e14'  // Orange
                ]
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { position: 'bottom' }
            }
        }
    });
</script>

<style>
.border-left-primary { border-left: 4px solid #4e73df !important; }
.border-left-success { border-left: 4px solid #1cc88a !important; }
.border-left-info { border-left: 4px solid #36b9cc !important; }
.border-left-warning { border-left: 4px solid #f6c23e !important; }
.border-left-secondary { border-left: 4px solid #858796 !important; }
.border-left-dark { border-left: 4px solid #5a5c69 !important; }
.border-left-danger { border-left: 4px solid #e74a3b !important; }
.text-xs { font-size: .7rem; }
</style>
{% endblock %}