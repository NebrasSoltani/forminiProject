{% extends 'base.html.twig' %}

{% block title %}Gestion des Événements{% endblock %}

{% block body %}
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0">Gestion des Événements</h4>
                    <div class="page-title-right">
                        <a href="{{ path('admin_evenement_statistiques') }}" class="btn btn-info me-2">
                            <i class="mdi mdi-chart-bar"></i> Statistiques
                        </a>
                        <a href="{{ path('admin_evenement_new') }}" class="btn btn-primary">
                            <i class="mdi mdi-plus"></i> Nouvel Événement
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Barre de recherche et filtres #}
        <div class="row mb-3">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <form method="get" class="row g-3">
                            <div class="col-md-3">
                                <label for="search" class="form-label">Recherche</label>
                                <input type="text" class="form-control" id="search" name="search" 
                                       value="{{ currentSearch ?? '' }}" placeholder="Titre, description, lieu...">
                            </div>
                            <div class="col-md-2">
                                <label for="type" class="form-label">Type</label>
                                <select class="form-select" id="type" name="type">
                                    <option value="">Tous les types</option>
                                    {% for t in typesDisponibles %}
                                        <option value="{{ t }}" {% if currentType == t %}selected{% endif %}>{{ t }}</option>
                                    {% endfor %}
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label for="statut" class="form-label">Statut</label>
                                <select class="form-select" id="statut" name="statut">
                                    <option value="">Tous</option>
                                    <option value="actif" {% if currentStatut == 'actif' %}selected{% endif %}>Actifs</option>
                                    <option value="inactif" {% if currentStatut == 'inactif' %}selected{% endif %}>Inactifs</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label for="sort" class="form-label">Trier par</label>
                                <select class="form-select" id="sort" name="sort">
                                    <option value="dateDebut" {% if currentSort == 'dateDebut' %}selected{% endif %}>Date début</option>
                                    <option value="titre" {% if currentSort == 'titre' %}selected{% endif %}>Titre</option>
                                    <option value="type" {% if currentSort == 'type' %}selected{% endif %}>Type</option>
                                    <option value="nombrePlaces" {% if currentSort == 'nombrePlaces' %}selected{% endif %}>Places</option>
                                </select>
                            </div>
                            <div class="col-md-1">
                                <label for="order" class="form-label">Ordre</label>
                                <select class="form-select" id="order" name="order">
                                    <option value="DESC" {% if currentOrder == 'DESC' %}selected{% endif %}>↓</option>
                                    <option value="ASC" {% if currentOrder == 'ASC' %}selected{% endif %}>↑</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">&nbsp;</label>
                                <div class="d-flex gap-2">
                                    <button type="submit" class="btn btn-primary flex-fill">
                                        <i class="mdi mdi-magnify"></i> Filtrer
                                    </button>
                                    <a href="{{ path('admin_evenement_index') }}" class="btn btn-secondary">
                                        <i class="mdi mdi-refresh"></i>
                                    </a>
                                    <a href="{{ path('admin_evenement_export_pdf', app.request.query.all) }}" 
                                       class="btn btn-danger" title="Export PDF">
                                        <i class="mdi mdi-file-pdf"></i>
                                    </a>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-body">
                        <div class="mb-3 d-flex justify-content-between align-items-center">
                            <h5 class="card-title mb-0">
                                <i class="mdi mdi-calendar-multiple"></i> Liste des Événements 
                                <span class="badge bg-primary">{{ evenements|length }}</span>
                            </h5>
                        </div>
                        
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>Image</th>
                                        <th>
                                            <a href="{{ path('admin_evenement_index', app.request.query.all|merge({'sort': 'titre', 'order': currentSort == 'titre' and currentOrder == 'ASC' ? 'DESC' : 'ASC'})) }}" class="text-dark">
                                                Titre {% if currentSort == 'titre' %}<i class="mdi mdi-arrow-{{ currentOrder == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                                            </a>
                                        </th>
                                        <th>
                                            <a href="{{ path('admin_evenement_index', app.request.query.all|merge({'sort': 'type', 'order': currentSort == 'type' and currentOrder == 'ASC' ? 'DESC' : 'ASC'})) }}" class="text-dark">
                                                Type {% if currentSort == 'type' %}<i class="mdi mdi-arrow-{{ currentOrder == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                                            </a>
                                        </th>
                                        <th>
                                            <a href="{{ path('admin_evenement_index', app.request.query.all|merge({'sort': 'dateDebut', 'order': currentSort == 'dateDebut' and currentOrder == 'ASC' ? 'DESC' : 'ASC'})) }}" class="text-dark">
                                                Date Début {% if currentSort == 'dateDebut' %}<i class="mdi mdi-arrow-{{ currentOrder == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                                            </a>
                                        </th>
                                        <th>Lieu</th>
                                        <th>
                                            <a href="{{ path('admin_evenement_index', app.request.query.all|merge({'sort': 'nombrePlaces', 'order': currentSort == 'nombrePlaces' and currentOrder == 'ASC' ? 'DESC' : 'ASC'})) }}" class="text-dark">
                                                Places {% if currentSort == 'nombrePlaces' %}<i class="mdi mdi-arrow-{{ currentOrder == 'ASC' ? 'up' : 'down' }}"></i>{% endif %}
                                            </a>
                                        </th>
                                        <th>Statut</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for evenement in evenements %}
                                        <tr>
                                            <td>
                                                {% if evenement.image %}
                                                    <img src="{{ asset('uploads/evenements/' ~ evenement.image) }}" alt="{{ evenement.titre }}" style="width: 60px; height: 60px; object-fit: cover; border-radius: 5px;">
                                                {% else %}
                                                    <div style="width: 60px; height: 60px; background: #f0f0f0; border-radius: 5px; display: flex; align-items: center; justify-content: center;">
                                                        <i class="mdi mdi-calendar" style="font-size: 24px; color: #ccc;"></i>
                                                    </div>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <strong>{{ evenement.titre }}</strong>
                                            </td>
                                            <td><span class="badge badge-info">{{ evenement.type }}</span></td>
                                            <td>{{ evenement.dateDebut|date('d/m/Y H:i') }}</td>
                                            <td>{{ evenement.lieu|length > 30 ? evenement.lieu|slice(0, 30) ~ '...' : evenement.lieu }}</td>
                                            <td class="text-center">
                                                {% if evenement.nombrePlaces %}
                                                    <strong>{{ evenement.nombrePlaces }}</strong>
                                                {% else %}
                                                    <span class="text-muted">∞</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                {% if evenement.isActif %}
                                                    <span class="badge badge-success">Actif</span>
                                                {% else %}
                                                    <span class="badge badge-secondary">Inactif</span>
                                                {% endif %}
                                            </td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    {# Bouton PDF #}
                                                    <a href="{{ path('admin_evenement_single_pdf', {id: evenement.id}) }}" 
                                                       class="btn btn-outline-danger" 
                                                       title="Exporter en PDF">
                                                        <i class="fas fa-file-pdf"></i>
                                                    </a>
                                                    
                                                    {# Bouton Participants #}
                                                    <a href="{{ path('admin_evenement_participants', {id: evenement.id}) }}" 
                                                       class="btn btn-outline-info" 
                                                       title="Voir les participants">
                                                        <i class="fas fa-users"></i>
                                                    </a>

                                                    {# Bouton Modifier #}
                                                    <a href="{{ path('admin_evenement_edit', {id: evenement.id}) }}" 
                                                       class="btn btn-outline-primary" 
                                                       title="Modifier">
                                                        <i class="fas fa-edit"></i>
                                                    </a>

                                                    {# Bouton Résumé IA (si existe) #}
                                                    {% if evenement.resumeAuto %}
                                                    <button type="button" 
                                                            class="btn btn-outline-info" 
                                                            title="Consulter le rapport d'intelligence artificielle"
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#aiModal{{ evenement.id }}">
                                                        <i class="fas fa-magic"></i>
                                                    </button>
                                                    {% endif %}

                                                    {# Bouton Supprimer avec formulaire #}
                                                    <form method="post" 
                                                          action="{{ path('admin_evenement_delete', {'id': evenement.id}) }}" 
                                                          style="display:inline;"
                                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer l\'événement « {{ evenement.titre|escape('js') }} » ?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ evenement.id) }}">
                                                        <button type="submit" class="btn btn-outline-danger" title="Supprimer">
                                                            <i class="fas fa-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>

                                        {# Modal pour le rapport IA #}
                                        {% if evenement.resumeAuto %}
                                        <div class="modal fade" id="aiModal{{ evenement.id }}" tabindex="-1" aria-labelledby="aiModalLabel{{ evenement.id }}" aria-hidden="true">
                                            <div class="modal-dialog modal-dialog-centered modal-lg">
                                                <div class="modal-content border-0 shadow-lg">
                                                    <div class="modal-header bg-info text-white">
                                                        <h5 class="modal-title d-flex align-items-center" id="aiModalLabel{{ evenement.id }}">
                                                            <i class="mdi mdi-robot-happy-outline mdi-24px me-2 text-white"></i> 
                                                            Intelligence Artificielle - Rapport de Live
                                                        </h5>
                                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                    </div>
                                                    <div class="modal-body p-4">
                                                        <div class="text-center mb-4">
                                                            <div class="avatar-lg mx-auto mb-3">
                                                                <div class="avatar-title bg-soft-info text-info display-4 rounded-circle">
                                                                    <i class="mdi mdi-magic-staff"></i>
                                                                </div>
                                                            </div>
                                                            <h4 class="text-info">{{ evenement.titre }}</h4>
                                                            <p class="text-muted mb-0">
                                                                Généré le {{ evenement.resumeGeneratedAt ? evenement.resumeGeneratedAt|date('d/m/Y à H:i') : 'Récemment' }}
                                                            </p>
                                                        </div>

                                                        {# Statistiques et Graphiques du Live #}
                                                        {% if evenement.liveSummaryData %}
                                                            {# Si on a les données de timeline, on affiche la vue Dashboard avec graphiques #}
                                                            {% if evenement.liveSummaryData.chart_timeline is defined and evenement.liveSummaryData.chart_timeline %}
                                                               <div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card bg-soft-primary border-primary shadow-none text-center">
            <div class="card-body p-3">
                <h2 class="text-primary mb-1">{{ evenement.liveSummaryData.total_reactions|default(0) }}</h2>
                <div class="text-uppercase fw-bold text-primary small mb-2">Réactions</div>
                <div style="position: relative; height: 120px;">
                    <canvas id="reactionChart{{ evenement.id }}"></canvas>
                </div>
            </div>
        </div>
    </div>
    <div class="col-md-8">
        <div class="card bg-soft-info border-info shadow-none">
            <div class="card-body p-3">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <div class="text-uppercase fw-bold text-info small">Engagement (Timeline)</div>
                    <span class="badge bg-info">{{ evenement.liveSummaryData.total_commentaires|default(0) }} msgs</span>
                </div>
                <div style="position: relative; height: 120px;">
                    <canvas id="engagementChart{{ evenement.id }}"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

                                                                <script>
                                                                    (function() {
                                                                        const modalId = '#aiModal{{ evenement.id }}';
                                                                        const data = {{ evenement.liveSummaryData|json_encode|raw }};
                                                                        let engagementChart = null;
                                                                        let reactionChart = null;

                                                                        document.querySelector(modalId).addEventListener('shown.bs.modal', function () {
                                                                            // Chart Engagement (Timeline)
                                                                            if (data.chart_timeline && !engagementChart) {
                                                                                engagementChart = new Chart(document.getElementById('engagementChart{{ evenement.id }}'), {
                                                                                    type: 'line',
                                                                                    data: {
                                                                                        labels: data.chart_timeline.labels,
                                                                                        datasets: [
                                                                                            {
                                                                                                label: 'Réactions',
                                                                                                data: data.chart_timeline.reactions,
                                                                                                borderColor: '#4e73df',
                                                                                                backgroundColor: 'rgba(78, 115, 223, 0.1)',
                                                                                                fill: true,
                                                                                                tension: 0.4
                                                                                            },
                                                                                            {
                                                                                                label: 'Commentaires',
                                                                                                data: data.chart_timeline.comments,
                                                                                                borderColor: '#36b9cc',
                                                                                                backgroundColor: 'rgba(54, 185, 204, 0.1)',
                                                                                                fill: true,
                                                                                                tension: 0.4
                                                                                            }
                                                                                        ]
                                                                                    },
                                                                                    options: {
                                                                                        responsive: true,
                                                                                        maintainAspectRatio: false,
                                                                                        plugins: { legend: { display: false } },
                                                                                        scales: {
                                                                                            x: { display: true, grid: { display: false } },
                                                                                            y: { beginAtZero: true, grid: { color: '#f0f0f0' } }
                                                                                        }
                                                                                    }
                                                                                });
                                                                            }

                                                                            // Chart Réactions (Doughnut)
                                                                            if (data.reaction_distribution && !reactionChart) {
                                                                                const dist = data.reaction_distribution;
                                                                                reactionChart = new Chart(document.getElementById('reactionChart{{ evenement.id }}'), {
                                                                                    type: 'doughnut',
                                                                                    data: {
                                                                                        labels: Object.keys(dist),
                                                                                        datasets: [{
                                                                                            data: Object.values(dist),
                                                                                            backgroundColor: ['#4e73df', '#1cc88a', '#36b9cc', '#f6c23e', '#e74a3b', '#858796'],
                                                                                            borderWidth: 0
                                                                                        }]
                                                                                    },
                                                                                    options: {
                                                                                        responsive: true,
                                                                                        maintainAspectRatio: false,
                                                                                        plugins: { legend: { display: false } },
                                                                                        cutout: '70%'
                                                                                    }
                                                                                });
                                                                            }
                                                                        });
                                                                    })();
                                                                </script>
                                                            {# Sinon on affiche la vue simplifiée pour les anciens rapports #}
                                                            {% else %}
                                                                <div class="row g-3 mb-4">
                                                                    <div class="col-md-6">
                                                                        <div class="card bg-soft-primary border-primary shadow-none h-100">
                                                                            <div class="card-body p-3 text-center">
                                                                                <div class="display-6 text-primary mb-1">
                                                                                    <i class="mdi mdi-heart-pulse"></i> {{ evenement.liveSummaryData.total_reactions|default(0) }}
                                                                                </div>
                                                                                <div class="text-uppercase fw-bold text-primary small">Réactions totales</div>
                                                                                <div class="mt-2 small text-muted">
                                                                                    {{ evenement.liveSummaryData.repartition|trim(', ') }}
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-6">
                                                                        <div class="card bg-soft-info border-info shadow-none h-100">
                                                                            <div class="card-body p-3 text-center">
                                                                                <div class="display-6 text-info mb-1">
                                                                                    <i class="mdi mdi-comment-multiple"></i> {{ evenement.liveSummaryData.total_commentaires|default(0) }}
                                                                                </div>
                                                                                <div class="text-uppercase fw-bold text-info small">Commentaires</div>
                                                                                <div class="mt-2 small text-muted">
                                                                                    Top : {{ evenement.liveSummaryData.top_contributeurs|default('N/A') }}
                                                                                </div>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="alert alert-soft-warning border-warning mb-4 p-2 text-center">
                                                                    <small><strong>Note :</strong> Les graphiques détaillés arriveront sur vos prochains lives !</small>
                                                                </div>
                                                            {% endif %}
                                                        {% else %}
                                                            <div class="alert alert-soft-warning border-warning d-flex align-items-center mb-4 p-2">
                                                                <i class="mdi mdi-information-outline mdi-18px me-2"></i>
                                                                <div class="small">
                                                                    <strong>Note :</strong> Les compteurs détaillés ne sont pas encore disponibles pour ce rapport ancien. 
                                                                    Relancez et terminez un live pour les activer.
                                                                </div>
                                                            </div>
                                                        {% endif %}

                                                        <div class="ai-report-content p-4 rounded-3 border-start border-4 border-info" style="background-color: #f8f9fa;">
                                                            <div class="mb-2 text-uppercase fw-bold text-info" style="font-size: 0.75rem; letter-spacing: 1px;">
                                                                Analyse d'Ollama
                                                            </div>
                                                            <div class="fs-5 text-dark lh-base italic" style="font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;">
                                                                "{{ evenement.resumeAuto|raw|nl2br }}"
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer bg-light">
                                                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
                                                        <a href="{{ path('admin_evenement_edit', {id: evenement.id}) }}" class="btn btn-primary">
                                                            <i class="fas fa-edit me-1"></i> Modifier l'événement
                                                        </a>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                        {% endif %}
                                    {% else %}
                                        <tr>
                                            <td colspan="8" class="text-center text-muted py-4">
                                                <i class="mdi mdi-calendar-remove" style="font-size: 48px;"></i>
                                                <p class="mt-2">Aucun événement trouvé</p>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
