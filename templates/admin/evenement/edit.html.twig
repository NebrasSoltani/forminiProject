{% extends 'base.html.twig' %}

{% block title %}Nouvel Événement{% endblock %}

{% block body %}
<div class="page-content">
    <div class="container-fluid">
        <div class="row">
            <div class="col-12">
                <div class="page-title-box d-flex align-items-center justify-content-between">
                    <h4 class="mb-0">Créer un Nouvel Événement</h4>
                    <div class="page-title-right">
                        <a href="{{ path('admin_evenement_index') }}" class="btn btn-secondary">
                            <i class="mdi mdi-arrow-left"></i> Retour
                        </a>
                    </div>
                </div>
            </div>
        </div>

        {# Affichage des messages flash #}
        

        <div class="row">
            <div class="col-lg-8">
                <div class="card">
                    <div class="card-body">
                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                            <div class="mb-3">
                                {{ form_label(form.titre) }}
                                {{ form_widget(form.titre) }}
                                {{ form_errors(form.titre) }}
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.type) }}
                                    {{ form_widget(form.type) }}
                                    {{ form_errors(form.type) }}
                                </div>
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.nombrePlaces) }}
                                    {{ form_widget(form.nombrePlaces) }}
                                    {{ form_errors(form.nombrePlaces) }}
                                </div>
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.description) }}
                                {{ form_widget(form.description) }}
                                {{ form_errors(form.description) }}
                            </div>

                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.dateDebut) }}
                                    {{ form_widget(form.dateDebut) }}
                                    {{ form_errors(form.dateDebut) }}
                                </div>
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.dateFin) }}
                                    {{ form_widget(form.dateFin) }}
                                    {{ form_errors(form.dateFin) }}
                                </div>
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.lieu) }}
                                {{ form_widget(form.lieu) }}
                                {{ form_errors(form.lieu) }}
                            </div>

                            <div class="mb-3">
                                {{ form_label(form.image, 'Image de l\'événement') }}
                                {{ form_widget(form.image, {'attr': {'class': 'form-control'}}) }}
                                {{ form_errors(form.image) }}
                                <small class="text-muted">Formats acceptés: JPG, PNG, GIF, WEBP (Max 2MB)</small>
                            </div>

                            {# 360 View #}
                            <div class="card bg-light border-0 mb-3">
                                <div class="card-body">
                                    <h5 class="card-title mb-3"><i class="mdi mdi-vr-cardboard text-primary"></i> Visite Immersive 360°</h5>
                                    
                                    {% if evenement.image360 %}
                                    <div class="mb-3">
                                        <p class="mb-1 text-muted small">Image 360° actuelle :</p>
                                        <img src="{{ asset('uploads/evenements/' ~ evenement.image360) }}" alt="Preview 360" class="img-thumbnail mb-2" style="max-height: 100px;">
                                    </div>
                                    {% endif %}

                                    <div class="mb-3">
                                        {{ form_label(form.image360, 'Changer l\'image 360°') }}
                                        {{ form_widget(form.image360, {'attr': {'class': 'form-control'}}) }}
                                        {{ form_errors(form.image360) }}
                                    </div>

                                    <div class="mb-0">
                                        {{ form_label(form.urlStreetView, 'Lien Google Street View') }}
                                        {{ form_widget(form.urlStreetView, {'attr': {'class': 'form-control', 'placeholder': 'https://www.google.com/maps/embed?pb=...'}}) }}
                                        {{ form_errors(form.urlStreetView) }}
                                    </div>
                                </div>
                            </div>

                            {# Live Stream #}
                            <div class="card bg-danger border-0 mb-3 text-white">
                                <div class="card-body">
                                    <h5 class="card-title mb-3 text-white"><i class="fa fa-dot-circle-o"></i> Configuration du Direct (Live)</h5>
                                    
                                    <div class="mb-3">
                                        <div class="form-check form-switch">
                                            {{ form_widget(form.live, {'attr': {'class': 'form-check-input'}}) }}
                                            {{ form_label(form.live, 'Événement actuellement en Live', {'label_attr': {'class': 'form-check-label'}}) }}
                                        </div>
                                    </div>

                                    <div class="mb-0">
                                        {{ form_label(form.streamUrl, 'URL du Flux (HLS .m3u8)') }}
                                        {{ form_widget(form.streamUrl, {'attr': {'class': 'form-control', 'placeholder': 'https://example.com/live/index.m3u8'}}) }}
                                        {{ form_errors(form.streamUrl) }}
                                    </div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <div class="form-check">
                                    {{ form_widget(form.isActif) }}
                                    {{ form_label(form.isActif) }}
                                </div>
                            </div>

                            {# On rend les champs restants avant le bouton #}
                            {{ form_rest(form) }}

                            <div class="text-end mt-4">
                                <button type="submit" class="btn btn-primary btn-lg px-4">
                                    <i class="mdi mdi-content-save me-1"></i> Enregistrer les modifications
                                </button>
                            </div>
                        {{ form_end(form, {'render_rest': false}) }}
                    </div>
                </div>
            </div>

            <div class="col-lg-4">
                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">Conseils</h5>
                        <ul class="list-unstyled">
                            <li class="mb-2"><i class="mdi mdi-chevron-right text-primary"></i> Choisissez un titre clair et descriptif</li>
                            <li class="mb-2"><i class="mdi mdi-chevron-right text-primary"></i> Définissez des dates cohérentes</li>
                            <li class="mb-2"><i class="mdi mdi-chevron-right text-primary"></i> Utilisez une image pertinente</li>
                            <li class="mb-2"><i class="mdi mdi-chevron-right text-primary"></i> Rédigez une description complète</li>
                            <li class="mb-2"><i class="mdi mdi-chevron-right text-primary"></i> Sélectionnez le type approprié</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

{% include 'admin/evenement/_ai_chat.html.twig' %}
{% endblock %}