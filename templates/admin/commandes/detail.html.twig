{% extends 'base.html.twig' %}

{% block title %}Commande {{ commande.reference }}{% endblock %}

{% block body %}
<div class="container py-5">
    <div class="col-lg-10 col-12 mx-auto">

        {# ===================================================== #}
        {# HEADER ACTIONS : Retour / Statut / Supprimer           #}
        {# ===================================================== #}
        <div class="card shadow-sm border-0 mb-4 rounded-4">
            <div class="card-body d-flex flex-wrap align-items-center justify-content-between gap-3">

                {# Retour #}
                <a href="{{ path('admin_commandes') }}" class="btn btn-secondary btn-lg">
                    <i class="fas fa-arrow-left me-1"></i> Retour
                </a>

                {# Modifier statut #}
                <form method="post"
                      action="{{ path('admin_commande_update_statut', {id: commande.id}) }}"
                      class="d-flex gap-2 align-items-stretch">

                    <input type="hidden" name="_token" value="{{ csrf_token('update_statut' ~ commande.id) }}">

                    <select name="statut" class="form-select form-select-lg">
                        <option value="en_attente" {% if commande.statut == 'en_attente' %}selected{% endif %}>En attente</option>
                        <option value="confirmee" {% if commande.statut == 'confirmee' %}selected{% endif %}>Confirmée</option>
                        <option value="en_cours" {% if commande.statut == 'en_cours' %}selected{% endif %}>En cours</option>
                        <option value="livree" {% if commande.statut == 'livree' %}selected{% endif %}>Livrée</option>
                        <option value="annulee" {% if commande.statut == 'annulee' %}selected{% endif %}>Annulée</option>
                    </select>

                    <button type="submit" class="btn btn-primary btn-lg px-4">
                        <i class="fas fa-save me-1"></i> Mettre à jour
                    </button>
                </form>

                {# Supprimer #}
                <form method="post"
                      action="{{ path('admin_commande_delete', {id: commande.id}) }}"
                      onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cette commande ?');">

                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ commande.id) }}">

                    <button type="submit" class="btn btn-danger btn-lg">
                        <i class="fas fa-trash-alt me-1"></i> Supprimer
                    </button>
                </form>

            </div>
        </div>


        {# ===================================================== #}
        {# FLASH MESSAGES                                        #}
        {# ===================================================== #}
        {% for label, messages in app.flashes %}
            {% for message in messages %}
                <div class="alert alert-{{ label }} alert-dismissible fade show shadow-sm">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        {% endfor %}


        {# ===================================================== #}
        {# CARD PRINCIPALE                                        #}
        {# ===================================================== #}
        <div class="card shadow rounded-4 border-0">
            <div class="card-body">

                {# ===== Titre + badge statut ===== #}
                <div class="d-flex justify-content-between align-items-center flex-wrap mb-4 gap-3">

                    <div>
                        <h3 class="fw-bold mb-1">Commande {{ commande.reference }}</h3>
                        <small class="text-muted">
                            Passée le {{ commande.dateCommande|date('d/m/Y à H:i') }}
                        </small>
                    </div>

                    {% set colors = {
                        'en_attente':'warning',
                        'confirmee':'info',
                        'en_cours':'primary',
                        'livree':'success',
                        'annulee':'danger'
                    } %}

                    <span class="badge bg-{{ colors[commande.statut]|default('dark') }} fs-6 rounded-pill px-4 py-2">
                        {{ commande.statut|capitalize }}
                    </span>
                </div>

                <hr>


                {# ===================================================== #}
                {# CLIENT + ADRESSE                                     #}
                {# ===================================================== #}
                <div class="row g-4 mb-4">

                    {# Client #}
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-primary text-white">
                                <i class="fas fa-user me-2"></i> Informations Client
                            </div>
                            <div class="card-body">
                                <p><strong>Nom :</strong> {{ commande.utilisateur.nom }} {{ commande.utilisateur.prenom }}</p>
                                <p><strong>Email :</strong> {{ commande.utilisateur.email }}</p>

                                {% if commande.telephone %}
                                    <p><strong>Téléphone :</strong> {{ commande.telephone }}</p>
                                {% endif %}

                                <span class="badge bg-info-subtle text-info">
                                    {{ commande.utilisateur.roleUtilisateur }}
                                </span>
                            </div>
                        </div>
                    </div>

                    {# Adresse #}
                    <div class="col-md-6">
                        <div class="card shadow-sm border-0 h-100">
                            <div class="card-header bg-info text-white">
                                <i class="fas fa-map-marker-alt me-2"></i> Adresse de livraison
                            </div>
                            <div class="card-body">
                                {{ commande.adresseLivraison ?: 'Non renseignée' }}
                            </div>
                        </div>
                    </div>
                </div>


                {# ===================================================== #}
                {# TABLE PRODUITS                                        #}
                {# ===================================================== #}
                <h5 class="fw-bold mb-3">Détails de la commande</h5>

                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center">

                        <thead class="table-light">
                        <tr>
                            <th class="text-start">Produit</th>
                            <th>Prix</th>
                            <th>Qté</th>
                            <th>Total</th>
                        </tr>
                        </thead>

                        <tbody>
                        {% for item in commande.items %}
                            <tr>
                                <td class="text-start fw-semibold">
                                    {{ item.nomProduit }}
                                </td>
                                <td>{{ item.prixUnitaire|number_format(2, ',', ' ') }} dt</td>
                                <td>
                                    <span class="badge bg-info-subtle text-info">
                                        {{ item.quantite }}
                                    </span>
                                </td>
                                <td class="fw-bold text-primary">
                                    {{ item.getSousTotal()|number_format(2, ',', ' ') }} dt
                                </td>
                            </tr>
                        {% endfor %}
                        </tbody>

                        <tfoot class="table-light">
                        <tr>
                            <td colspan="3" class="text-end fw-bold">Total :</td>
                            <td class="fw-bold fs-5 text-success">
                                {{ commande.calculerTotal()|number_format(2, ',', ' ') }} dt
                            </td>
                        </tr>
                        </tfoot>

                    </table>
                </div>

            </div>
        </div>

    </div>
</div>
{% endblock %}
